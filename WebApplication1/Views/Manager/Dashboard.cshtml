@model QLDuLichRBAC_Upgrade.Models.ViewModels.ManagerDashboardVm
@{
    ViewData["Title"] = "Tổng quan Quản Lý";
    var fullName = string.IsNullOrWhiteSpace(Model.FullName) ? "Quản lý" : Model.FullName;
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">M</div>
            <div class="brand-text">
                <div class="brand-name">Quản Lý</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item active" asp-controller="Manager" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>

            <a class="menu-item" asp-controller="Manager" asp-action="CreateTask">
                <span class="mi-ico">➕</span>
                <span class="mi-text">Tạo công việc</span>
            </a>

            <a class="menu-item" asp-controller="Manager" asp-action="Tasks">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Danh sách công việc</span>
            </a>

            <a class="menu-item" asp-controller="Manager" asp-action="SupportRequests">
                <span class="mi-ico">🆘</span>
                <span class="mi-text">Yêu cầu hỗ trợ</span>
                @if (Model.PendingSupportRequests > 0)
                {
                    <span class="badge-count">@Model.PendingSupportRequests</span>
                }
            </a>

            <a class="menu-item" asp-controller="Manager" asp-action="Complaints">
                <span class="mi-ico">💬</span>
                <span class="mi-text">Góp ý khách hàng</span>
            </a>

            <div class="menu-divider"></div>

            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>

        <div class="sidebar-footer">
            <div class="badge">
                <div class="dot"></div>
                <span>Hệ thống đang hoạt động</span>
            </div>
            <div class="tiny">© @DateTime.Now.Year</div>
        </div>
    </aside>

    <!-- Main -->
    <main class="main">
        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar" title="Thu gọn sidebar">☰</button>

                <div class="page-title">
                    <div class="title">Tổng quan</div>
                    <div class="subtitle">
                        Xin chào, <strong>@fullName</strong>. Chúc bạn một ngày làm việc hiệu quả.
                    </div>
                </div>
            </div>

            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Ban Quản Lý</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <section class="content">
            <!-- Stat cards -->
            <div class="grid stats">
                <div class="card stat glow">
                    <div class="stat-head">
                        <div class="stat-ico">💰</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Số dư quỹ</div>
                            <div class="kpi-value text-success">@Model.CurrentBalance.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">VND</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">💵</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Tổng quyên góp</div>
                            <div class="kpi-value">@Model.TotalDonations.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">VND</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">💸</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Tổng chi</div>
                            <div class="kpi-value text-danger">@Model.TotalExpenses.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">VND</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">👥</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Đối tượng hỗ trợ</div>
                            <div class="kpi-value">@Model.TotalBeneficiaries</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">Người cần hỗ trợ</span>
                    </div>
                </div>
            </div>

            <!-- Task stats -->
            <div class="grid stats">
                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">⏳</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Chờ thực hiện</div>
                            <div class="kpi-value">@Model.PendingTasks</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">Công việc đang chờ</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">🔄</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Đang thực hiện</div>
                            <div class="kpi-value">@Model.TasksInProgress</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">Nhân viên đang làm</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">🆘</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Yêu cầu hỗ trợ</div>
                            <div class="kpi-value text-warning">@Model.PendingSupportRequests</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">Cần xử lý</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">✅</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Hoàn thành hôm nay</div>
                            <div class="kpi-value">@Model.CompletedToday</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">Công việc hoàn tất</span>
                    </div>
                </div>
            </div>

            <!-- Quick actions + Support requests -->
            <div class="grid two-col">
                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Chức năng chính</div>
                            <div class="panel-sub">Truy cập nhanh các phân hệ</div>
                        </div>
                        <div class="chip">Thao tác nhanh</div>
                    </div>

                    <div class="actions">
                        <a class="action-card" asp-controller="Manager" asp-action="CreateTask">
                            <div class="action-ico">➕</div>
                            <div class="action-body">
                                <div class="action-title">Tạo công việc mới</div>
                                <div class="action-desc">Giao việc cho nhân viên hỗ trợ người cần</div>
                            </div>
                            <div class="action-go">→</div>
                        </a>

                        <a class="action-card" asp-controller="Manager" asp-action="Tasks">
                            <div class="action-ico">📋</div>
                            <div class="action-body">
                                <div class="action-title">Danh sách công việc</div>
                                <div class="action-desc">Xem tất cả công việc đã tạo</div>
                            </div>
                            <div class="action-go">→</div>
                        </a>

                        <a class="action-card" asp-controller="Manager" asp-action="SupportRequests">
                            <div class="action-ico">🆘</div>
                            <div class="action-body">
                                <div class="action-title">Xử lý yêu cầu hỗ trợ</div>
                                <div class="action-desc">Duyệt yêu cầu tiền/nhân lực từ nhân viên</div>
                            </div>
                            <div class="action-go">→</div>
                        </a>
                    </div>
                </div>

                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Yêu cầu hỗ trợ từ nhân viên</div>
                            <div class="panel-sub">@Model.PendingSupportRequests yêu cầu đang chờ</div>
                        </div>
                        <a asp-action="SupportRequests" class="chip">Xem tất cả →</a>
                    </div>

                    <div class="timeline">
                        @if (Model.SupportRequests != null && Model.SupportRequests.Count > 0)
                        {
                            foreach (var req in Model.SupportRequests.Take(5))
                            {
                                <div class="tl-item">
                                    <div class="tl-dot warning"></div>
                                    <div class="tl-content">
                                        <div class="tl-title">@req.AssignedStaff?.FullName - @req.SupportRequest?.Beneficiary?.FullName</div>
                                        <div class="tl-sub">@req.SupportRequestType: @(req.SupportRequestAmount?.ToString("N0") ?? "N/A") VND</div>
                                    </div>
                                    <a class="action-go" asp-controller="Manager" asp-action="SupportRequests">→</a>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="muted" style="padding: 1rem;">Không có yêu cầu hỗ trợ nào</p>
                        }
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

<style>
    .text-success { color: #22c55e; }
    .text-danger { color: #ef4444; }
    .text-warning { color: #f59e0b; }
    .tl-dot.warning { background: #f59e0b; }
    .badge-count {
        background: #ef4444;
        color: white;
        border-radius: 10px;
        padding: 2px 8px;
        font-size: 0.75rem;
        margin-left: auto;
    }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
