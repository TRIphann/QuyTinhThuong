@using QLDuLichRBAC_Upgrade.Models.ViewModels
@{
    ViewData["Title"] = "Phê Duyệt Yêu Cầu";
    var fullName = ViewData["FullName"]?.ToString() ?? "Quản lý";
    var request = ViewData["Request"] as SupportRequestVm;
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">M</div>
            <div class="brand-text">
                <div class="brand-name">Quản Lý</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Manager" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>

            <a class="menu-item active" asp-controller="Manager" asp-action="Requests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Duyệt hồ sơ</span>
            </a>

            <a class="menu-item" asp-controller="Manager" asp-action="Reports">
                <span class="mi-ico">📊</span>
                <span class="mi-text">Báo cáo</span>
            </a>

            <div class="menu-divider"></div>

            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <!-- Main -->
    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Phê Duyệt Yêu Cầu #@request?.RequestId</div>
                    <div class="subtitle">Xem xét và ra quyết định</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Ban Quản Lý</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="grid two-col">
                <!-- Request Info -->
                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Thông tin yêu cầu</div>
                            <div class="panel-sub">Chi tiết hồ sơ đề nghị hỗ trợ</div>
                        </div>
                    </div>

                    <div class="info-list">
                        <div class="info-row">
                            <span class="info-label">Đối tượng:</span>
                            <span class="info-value">@request?.BeneficiaryName</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Loại đối tượng:</span>
                            <span class="info-value"><span class="chip">@request?.BeneficiaryType</span></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Số tiền đề nghị:</span>
                            <span class="info-value"><strong>@request?.RequestedAmount.ToString("N0") VND</strong></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Ngày tạo:</span>
                            <span class="info-value">@request?.RequestDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Lý do:</span>
                            <span class="info-value">@(request?.Reason ?? "Không có")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Trạng thái:</span>
                            <span class="info-value"><span class="badge bg-warning text-dark">@request?.Status</span></span>
                        </div>
                    </div>
                </div>

                <!-- Approval Form -->
                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Quyết định phê duyệt</div>
                            <div class="panel-sub">Chọn kết quả xét duyệt</div>
                        </div>
                    </div>

                    <form asp-action="Approve" method="post" class="form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RequestId" value="@request?.RequestId" />

                        <div class="form-group">
                            <label class="form-label">Kết quả <span class="required">*</span></label>
                            <div class="radio-group">
                                <label class="radio-item approve">
                                    <input type="radio" name="Result" value="Đồng ý" required />
                                    <span class="radio-label">✅ Đồng ý</span>
                                </label>
                                <label class="radio-item reject">
                                    <input type="radio" name="Result" value="Từ chối" />
                                    <span class="radio-label">❌ Từ chối</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Ghi chú</label>
                            <textarea name="Note" class="form-control" rows="4" placeholder="Nhập ghi chú (nếu có)..."></textarea>
                        </div>

                        <div class="form-actions">
                            <a asp-action="Requests" class="btn btn-secondary">← Quay lại</a>
                            <button type="submit" class="btn btn-primary">Xác nhận</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </main>
</div>

<style>
    .info-list { padding: 1rem; }
    .info-row { display: flex; padding: 10px 0; border-bottom: 1px solid #3a3a4a; }
    .info-row:last-child { border-bottom: none; }
    .info-label { width: 140px; color: #a0a0b0; font-weight: 500; }
    .info-value { flex: 1; color: #ffffff; }
    .form { padding: 1rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-weight: 500; margin-bottom: 0.5rem; color: #e0e0e0; }
    .required { color: #ff6b6b; }
    .form-control { 
        width: 100%; 
        padding: 10px 14px; 
        border: 1px solid #4a4a5a; 
        border-radius: 6px; 
        font-size: 14px; 
        background: #2a2a3a;
        color: #fff;
    }
    .form-control:focus { 
        outline: none; 
        border-color: #6ee7ff; 
        box-shadow: 0 0 0 3px rgba(110, 231, 255, 0.15); 
    }
    .form-control::placeholder { color: #8a8a9a; }
    .radio-group { display: flex; gap: 1rem; }
    .radio-item { 
        display: flex; 
        align-items: center; 
        gap: 8px; 
        padding: 12px 20px; 
        border: 2px solid #4a4a5a; 
        border-radius: 8px; 
        cursor: pointer; 
        transition: all 0.2s; 
        background: #2a2a3a;
        color: #e0e0e0;
    }
    .radio-item:hover { border-color: #6ee7ff; }
    .radio-item.approve:has(input:checked) { border-color: #4ade80; background: rgba(74, 222, 128, 0.1); }
    .radio-item.reject:has(input:checked) { border-color: #ff6b6b; background: rgba(255, 107, 107, 0.1); }
    .radio-label { font-weight: 500; }
    .form-actions { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn { padding: 10px 20px; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; text-decoration: none; border: none; }
    .btn-primary { background: linear-gradient(135deg, #6ee7ff 0%, #4fb3ff 100%); color: #1a1a2e; }
    .btn-primary:hover { background: linear-gradient(135deg, #8ff0ff 0%, #6bc5ff 100%); }
    .btn-secondary { background: #3a3a4a; color: #e0e0e0; }
    .btn-secondary:hover { background: #4a4a5a; }
    .badge { padding: 4px 10px; border-radius: 4px; font-size: 12px; }
    .bg-warning { background: #ffc107; }
    .text-dark { color: #333; }
    
    /* Validation styles */
    .radio-group.invalid .radio-item { 
        border-color: #ff6b6b !important; 
        animation: shake 0.4s ease-in-out;
    }
    .error-message { 
        color: #ff6b6b; 
        font-size: 12px; 
        margin-top: 8px; 
        display: none; 
    }
    .error-message.show { display: block; }
    
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-5px); }
        40%, 80% { transform: translateX(5px); }
    }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
    
    // Form validation
    document.querySelector('form.form')?.addEventListener('submit', function(e) {
        let isValid = true;
        
        // Clear previous errors
        this.querySelectorAll('.radio-group').forEach(el => el.classList.remove('invalid'));
        this.querySelectorAll('.error-message').forEach(el => el.classList.remove('show'));
        
        // Radio button validation (must select one)
        const resultRadio = this.querySelector('input[name="Result"]:checked');
        if (!resultRadio) {
            const radioGroup = this.querySelector('.radio-group');
            if (radioGroup) {
                radioGroup.classList.add('invalid');
            }
            isValid = false;
        }
        
        if (!isValid) {
            e.preventDefault();
        }
    });
    
    // Real-time validation feedback for radio buttons
    document.querySelectorAll('input[name="Result"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelector('.radio-group')?.classList.remove('invalid');
        });
    });
</script>
