@model List<QLDuLichRBAC_Upgrade.Models.Entities.SupportRequest>
@{
    ViewData["Title"] = "Yêu Cầu Hỗ Trợ";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <partial name="_ManagerSidebar" />

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Quản Lý Yêu Cầu Hỗ Trợ</div>
                    <div class="subtitle">Xem và duyệt các yêu cầu hỗ trợ</div>
                </div>
            </div>
            <a asp-action="CreateRequest" class="btn" style="background: #22c55e; color: white; padding: 0.5rem 1rem; border-radius: 8px; text-decoration: none;">
                + Tạo Yêu Cầu Mới
            </a>
        </header>

        <section class="content">
            @if (TempData["Success"] != null)
            {
                <div style="background: #22c55e33; color: #22c55e; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
                    @TempData["Success"]
                </div>
            }

            <!-- Tab buttons -->
            <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
                <button class="tab-btn active" data-tab="all" style="padding: 0.5rem 1rem; border-radius: 8px; border: none; cursor: pointer; background: #3b82f6; color: white;">
                    Tất cả
                </button>
                <button class="tab-btn" data-tab="pending" style="padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #334155; cursor: pointer; background: transparent; color: #f8fafc;">
                    Chờ duyệt (@Model.Count(x => x.Status == "Chờ xét duyệt"))
                </button>
                <button class="tab-btn" data-tab="approved" style="padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #334155; cursor: pointer; background: transparent; color: #f8fafc;">
                    Đã duyệt (@Model.Count(x => x.Status == "Đã phê duyệt"))
                </button>
                <button class="tab-btn" data-tab="rejected" style="padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #334155; cursor: pointer; background: transparent; color: #f8fafc;">
                    Từ chối (@Model.Count(x => x.Status == "Từ chối"))
                </button>
            </div>

            <div class="card panel">
                <div class="panel-head">
                    <div class="panel-title">Danh sách yêu cầu hỗ trợ</div>
                </div>

                <table class="data-table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th style="padding: 1rem; text-align: left; border-bottom: 1px solid #334155;">ID</th>
                            <th style="padding: 1rem; text-align: left; border-bottom: 1px solid #334155;">Đối tượng</th>
                            <th style="padding: 1rem; text-align: right; border-bottom: 1px solid #334155;">Số tiền</th>
                            <th style="padding: 1rem; text-align: left; border-bottom: 1px solid #334155;">Lý do</th>
                            <th style="padding: 1rem; text-align: center; border-bottom: 1px solid #334155;">Trạng thái</th>
                            <th style="padding: 1rem; text-align: left; border-bottom: 1px solid #334155;">Ngày tạo</th>
                            <th style="padding: 1rem; text-align: center; border-bottom: 1px solid #334155;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Status switch {
                                "Chờ xét duyệt" => "pending",
                                "Đã phê duyệt" => "approved",
                                "Từ chối" => "rejected",
                                _ => "pending"
                            };
                            var statusText = item.Status switch {
                                "Chờ xét duyệt" => "Chờ duyệt",
                                "Đã phê duyệt" => "Đã duyệt",
                                "Từ chối" => "Từ chối",
                                _ => item.Status
                            };
                            <tr class="request-row" data-status="@statusClass">
                                <td style="padding: 1rem; border-bottom: 1px solid #1e293b;">#@item.RequestId</td>
                                <td style="padding: 1rem; border-bottom: 1px solid #1e293b;">
                                    <strong>@item.Beneficiary?.FullName</strong>
                                    <div style="font-size: 0.8rem; color: #64748b;">@item.Beneficiary?.BeneficiaryType</div>
                                </td>
                                <td style="padding: 1rem; border-bottom: 1px solid #1e293b; text-align: right; color: #22c55e; font-weight: bold;">@(item.RequestedAmount.HasValue ? item.RequestedAmount.Value.ToString("N0") + " ₫" : "Chưa xác định")</td>
                                <td style="padding: 1rem; border-bottom: 1px solid #1e293b;">@item.Reason</td>
                                <td style="padding: 1rem; border-bottom: 1px solid #1e293b; text-align: center;">
                                    <span class="badge @(item.Status == "Đã phê duyệt" ? "badge-success" : item.Status == "Từ chối" ? "badge-danger" : "badge-warning")"
                                          style="padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem;">
                                        @statusText
                                    </span>
                                </td>
                                <td style="padding: 1rem; border-bottom: 1px solid #1e293b;">@item.RequestDate.ToString("dd/MM/yyyy")</td>
                                <td style="padding: 1rem; border-bottom: 1px solid #1e293b; text-align: center;">
                                    @if (item.Status == "Chờ xét duyệt")
                                    {
                                        <button onclick="approveRequest(@item.RequestId)" style="padding: 0.25rem 0.5rem; background: #22c55e; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 0.25rem;">
                                            ✓ Duyệt
                                        </button>
                                        <button onclick="rejectRequest(@item.RequestId)" style="padding: 0.25rem 0.5rem; background: #ef4444; color: white; border: none; border-radius: 4px; cursor: pointer;">
                                            ✗ Từ chối
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div style="text-align: center; padding: 2rem; color: #64748b;">
                        Chưa có yêu cầu hỗ trợ nào
                    </div>
                }
            </div>
        </section>
    </main>
</div>

<style>
    .badge-success { background: #22c55e33; color: #22c55e; }
    .badge-danger { background: #ef444433; color: #ef4444; }
    .badge-warning { background: #eab30833; color: #eab308; }
    .tab-btn.active { background: #3b82f6 !important; border-color: #3b82f6 !important; }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });

    // Tab filtering
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('active');
                b.style.background = 'transparent';
            });
            this.classList.add('active');
            this.style.background = '#3b82f6';

            const tab = this.dataset.tab;
            document.querySelectorAll('.request-row').forEach(row => {
                if (tab === 'all') {
                    row.style.display = '';
                } else {
                    row.style.display = row.dataset.status === tab ? '' : 'none';
                }
            });
        });
    });

    function approveRequest(id) {
        if (!confirm('Bạn có chắc muốn duyệt yêu cầu này?')) return;
        
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Manager/ApproveRequest';
        
        var inputId = document.createElement('input');
        inputId.type = 'hidden';
        inputId.name = 'id';
        inputId.value = id;
        form.appendChild(inputId);
        
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            var inputToken = document.createElement('input');
            inputToken.type = 'hidden';
            inputToken.name = '__RequestVerificationToken';
            inputToken.value = token.value;
            form.appendChild(inputToken);
        }
        
        document.body.appendChild(form);
        form.submit();
    }

    function rejectRequest(id) {
        if (!confirm('Bạn có chắc muốn từ chối yêu cầu này?')) return;
        
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Manager/RejectRequest';
        
        var inputId = document.createElement('input');
        inputId.type = 'hidden';
        inputId.name = 'id';
        inputId.value = id;
        form.appendChild(inputId);
        
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            var inputToken = document.createElement('input');
            inputToken.type = 'hidden';
            inputToken.name = '__RequestVerificationToken';
            inputToken.value = token.value;
            form.appendChild(inputToken);
        }
        
        document.body.appendChild(form);
        form.submit();
    }
</script>
