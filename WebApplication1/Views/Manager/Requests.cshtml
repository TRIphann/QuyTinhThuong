@model List<QLDuLichRBAC_Upgrade.Models.ViewModels.SupportRequestVm>
@{
    ViewData["Title"] = "Duyệt Hồ Sơ";
    var fullName = ViewData["FullName"]?.ToString() ?? "Manager";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">M</div>
            <div class="brand-text">
                <div class="brand-name">Manager Panel</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Manager" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Dashboard</span>
            </a>

            <a class="menu-item active" asp-controller="Manager" asp-action="Requests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Duyệt hồ sơ</span>
            </a>

            <a class="menu-item" asp-controller="Manager" asp-action="Reports">
                <span class="mi-ico">📊</span>
                <span class="mi-text">Báo cáo</span>
            </a>

            <div class="menu-divider"></div>

            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <!-- Main -->
    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Duyệt Hồ Sơ Hỗ Trợ</div>
                    <div class="subtitle">Xem xét và phê duyệt các yêu cầu hỗ trợ</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Ban Quản Lý</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="card panel">
                <div class="panel-head">
                    <div>
                        <div class="panel-title">Danh sách yêu cầu hỗ trợ</div>
                        <div class="panel-sub">Tổng: @Model.Count yêu cầu</div>
                    </div>
                </div>

                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Đối tượng</th>
                            <th>Loại</th>
                            <th>Số tiền</th>
                            <th>Ngày tạo</th>
                            <th>Lý do</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td>@req.RequestId</td>
                                <td>@req.BeneficiaryName</td>
                                <td><span class="chip">@req.BeneficiaryType</span></td>
                                <td><strong>@req.RequestedAmount.ToString("N0") VND</strong></td>
                                <td>@req.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(req.Reason ?? "-")</td>
                                <td>
                                    @if (req.Status == "Chờ xét duyệt")
                                    {
                                        <span class="badge bg-warning text-dark">@req.Status</span>
                                    }
                                    else if (req.Status == "Đã duyệt" || req.Status == "Đã chi")
                                    {
                                        <span class="badge bg-success">@req.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@req.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (req.Status == "Chờ xét duyệt")
                                    {
                                        <a asp-action="Approve" asp-route-id="@req.RequestId" class="btn btn-sm btn-primary">Xét duyệt</a>
                                    }
                                    else
                                    {
                                        <span class="muted">Đã xử lý</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<style>
    .table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    .table th, .table td { padding: 12px; text-align: left; border-bottom: 1px solid #e5e7eb; }
    .table th { background: #f9fafb; font-weight: 600; }
    .badge { padding: 4px 10px; border-radius: 4px; font-size: 12px; }
    .bg-warning { background: #ffc107; }
    .bg-success { background: #28a745; color: white; }
    .bg-danger { background: #dc3545; color: white; }
    .text-dark { color: #333; }
    .btn { padding: 6px 14px; border-radius: 4px; text-decoration: none; font-size: 13px; }
    .btn-primary { background: #4f46e5; color: white; }
    .btn-primary:hover { background: #4338ca; }
    .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 1rem; }
    .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
