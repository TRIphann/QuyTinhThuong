@model List<QLDuLichRBAC_Upgrade.Models.Entities.Notification>
@{
    ViewData["Title"] = "Thông Báo";
    var fullName = ViewData["FullName"]?.ToString() ?? "Quản lý";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">Q</div>
            <div class="brand-text">
                <div class="brand-name">Quản Lý</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Manager" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>
            <a class="menu-item active" asp-controller="Manager" asp-action="Notifications">
                <span class="mi-ico">🔔</span>
                <span class="mi-text">Thông báo</span>
            </a>
            <a class="menu-item" asp-controller="Manager" asp-action="Tasks">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Công việc hỗ trợ</span>
            </a>
            <a class="menu-item" asp-controller="Manager" asp-action="Requests">
                <span class="mi-ico">📝</span>
                <span class="mi-text">Duyệt hồ sơ</span>
            </a>
            <a class="menu-item" asp-controller="Manager" asp-action="Reports">
                <span class="mi-ico">📊</span>
                <span class="mi-text">Báo cáo</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Thông Báo</div>
                    <div class="subtitle">@Model.Count thông báo</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Quản Lý</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">🔔</div>
                    <div class="empty-text">Không có thông báo</div>
                </div>
            }
            else
            {
                <div class="notification-list">
                    @foreach (var n in Model)
                    {
                        <div class="notification-card @(n.IsRead ? "" : "unread") @(n.Type.Contains("Từ chối") ? "rejected" : "")">
                            <div class="notif-icon @(n.Type.Contains("Từ chối") ? "icon-rejected" : n.Type.Contains("Phê duyệt") ? "icon-approved" : "")">
                                @switch (n.Type)
                                {
                                    case "Phê duyệt ngân sách":
                                        <span>✅</span>
                                        break;
                                    case "Từ chối ngân sách":
                                        <span>❌</span>
                                        break;
                                    case "Thanh toán mới":
                                        <span>💰</span>
                                        break;
                                    case "Chờ xác minh":
                                        <span>⏳</span>
                                        break;
                                    case "Khiếu nại":
                                        <span>⚠️</span>
                                        break;
                                    case "Yêu cầu hỗ trợ":
                                        <span>🆘</span>
                                        break;
                                    default:
                                        <span>🔔</span>
                                        break;
                                }
                            </div>
                            <div class="notif-content">
                                <div class="notif-title">@n.Title</div>
                                <div class="notif-message">@n.Message</div>
                                <div class="notif-time">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            @if (n.RelatedTaskId.HasValue)
                            {
                                <a href="/Manager/Tasks" class="notif-action">Xem chi tiết →</a>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </main>
</div>

<style>
    .notification-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .notification-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 20px;
        background: linear-gradient(145deg, #1e1e2e, #252538);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
    }

    .notification-card.unread {
        border-left: 4px solid #6366f1;
        background: linear-gradient(145deg, #252538, #2a2a4a);
    }

    .notification-card.rejected {
        border-left: 4px solid #ef4444;
        background: linear-gradient(145deg, #2a1a1a, #382020);
    }

    .notif-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(99, 102, 241, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .notif-icon.icon-approved {
        background: rgba(34, 197, 94, 0.2);
    }

    .notif-icon.icon-rejected {
        background: rgba(239, 68, 68, 0.2);
    }

    .notif-content {
        flex: 1;
        min-width: 0;
    }

    .notif-title {
        font-size: 16px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 6px;
    }

    .notif-message {
        font-size: 14px;
        color: #a0a0b0;
        line-height: 1.5;
        margin-bottom: 8px;
    }

    .notif-time {
        font-size: 12px;
        color: #707080;
    }

    .notif-action {
        padding: 8px 16px;
        background: rgba(99, 102, 241, 0.15);
        color: #6366f1;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.3s;
        white-space: nowrap;
    }

    .notif-action:hover {
        background: rgba(99, 102, 241, 0.25);
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 20px;
    }

    .empty-text {
        font-size: 18px;
        color: #808090;
    }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
