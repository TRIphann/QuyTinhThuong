@model QLDuLichRBAC_Upgrade.Controllers.ManagerReportVm
@{
    ViewData["Title"] = "Báo Cáo Tổng Hợp";
    var fullName = ViewData["FullName"]?.ToString() ?? "Manager";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">M</div>
            <div class="brand-text">
                <div class="brand-name">Manager Panel</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Manager" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Dashboard</span>
            </a>

            <a class="menu-item" asp-controller="Manager" asp-action="Requests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Duyệt hồ sơ</span>
            </a>

            <a class="menu-item active" asp-controller="Manager" asp-action="Reports">
                <span class="mi-ico">📊</span>
                <span class="mi-text">Báo cáo</span>
            </a>

            <div class="menu-divider"></div>

            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <!-- Main -->
    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Báo Cáo Tổng Hợp</div>
                    <div class="subtitle">Thống kê hoạt động phê duyệt và hỗ trợ</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Ban Quản Lý</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            <!-- Stats -->
            <div class="grid stats">
                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">📋</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Tổng yêu cầu</div>
                            <div class="kpi-value">@Model.TotalRequests</div>
                        </div>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">✅</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Đã duyệt</div>
                            <div class="kpi-value text-success">@Model.ApprovedRequests</div>
                        </div>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">❌</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Từ chối</div>
                            <div class="kpi-value text-danger">@Model.RejectedRequests</div>
                        </div>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">⏳</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Chờ duyệt</div>
                            <div class="kpi-value text-warning">@Model.PendingRequests</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid two-col">
                <!-- Summary -->
                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Tổng quan</div>
                            <div class="panel-sub">Thống kê chung</div>
                        </div>
                    </div>

                    <div class="info-list">
                        <div class="info-row">
                            <span class="info-label">Phê duyệt tháng này:</span>
                            <span class="info-value"><strong>@Model.ThisMonthApprovals</strong></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Tổng tiền đã duyệt:</span>
                            <span class="info-value"><strong class="text-success">@Model.TotalApprovedAmount.ToString("N0") VND</strong></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Tỷ lệ duyệt:</span>
                            <span class="info-value">
                                @if (Model.TotalRequests > 0)
                                {
                                    var rate = (double)Model.ApprovedRequests / Model.TotalRequests * 100;
                                    <strong>@rate.ToString("F1")%</strong>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Beneficiary Stats -->
                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Thống kê đối tượng</div>
                            <div class="panel-sub">Theo loại đối tượng hỗ trợ</div>
                        </div>
                    </div>

                    <div class="info-list">
                        @if (Model.BeneficiaryStats != null && Model.BeneficiaryStats.Count > 0)
                        {
                            foreach (var stat in Model.BeneficiaryStats)
                            {
                                <div class="info-row">
                                    <span class="info-label">@stat.Type:</span>
                                    <span class="info-value"><span class="chip">@stat.Count đối tượng</span></span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="muted">Chưa có dữ liệu</p>
                        }
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

<style>
    .info-list { padding: 1rem; }
    .info-row { display: flex; padding: 12px 0; border-bottom: 1px solid #e5e7eb; }
    .info-row:last-child { border-bottom: none; }
    .info-label { width: 180px; color: #6b7280; font-weight: 500; }
    .info-value { flex: 1; }
    .text-success { color: #22c55e; }
    .text-danger { color: #ef4444; }
    .text-warning { color: #f59e0b; }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
