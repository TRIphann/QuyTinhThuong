@model QLDuLichRBAC_Upgrade.Models.ViewModels.RegisterVm
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_AuthLayout";
}

<link rel="stylesheet" href="~/css/style.css" />
<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@if (ViewBag.ErrorAlert != null)
{
    @Html.Raw(ViewBag.ErrorAlert)
}

@if (ViewBag.SuccessAlert != null)
{
    @Html.Raw(ViewBag.SuccessAlert)
}

<section>
    <div class="content p-5" style="max-width: 500px; width: 100%;">
        <div class="info text-center w-100">
            <h2 class="fw-bold mb-4" style="color:white;">Tạo tài khoản mới</h2>

            <form asp-action="Register" method="post" class="text-start" id="registerForm">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold text-white">Họ và tên</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-white">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Nhập địa chỉ email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-semibold text-white">Tên đăng nhập</label>
                    <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold text-white">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu (ít nhất 6 ký tự)" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold text-white">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại (10-11 số)" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn w-100 py-2 mt-3">Đăng ký</button>

                <p class="mt-4 mb-0 text-center text-white">
                    Đã có tài khoản?
                    <a href="/Account/Login" class="fw-bold" style="color:#fff; text-decoration:underline;">Đăng nhập ngay</a>
                </p>
            </form>
        </div>
    </div>

    <!-- Hiệu ứng bay bay -->
    <ul class="circles">
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
    </ul>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
