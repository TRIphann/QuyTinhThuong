@{
    ViewData["Title"] = "Thêm Đối Tượng Hỗ Trợ";
    var fullName = ViewData["FullName"]?.ToString() ?? "Nhân viên";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">S</div>
            <div class="brand-text">
                <div class="brand-name">Nhân Viên</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Staff" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>
            <div class="menu-section">Quyên góp</div>
            <a class="menu-item" asp-controller="Staff" asp-action="Donors">
                <span class="mi-ico">👥</span>
                <span class="mi-text">Nhà hảo tâm</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Donations">
                <span class="mi-ico">💵</span>
                <span class="mi-text">Tiếp nhận quyên góp</span>
            </a>
            <div class="menu-section">Hỗ trợ</div>
            <a class="menu-item active" asp-controller="Staff" asp-action="Beneficiaries">
                <span class="mi-ico">🧑‍🤝‍🧑</span>
                <span class="mi-text">Đối tượng hỗ trợ</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Requests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Yêu cầu hỗ trợ</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Thêm Đối Tượng Hỗ Trợ</div>
                    <div class="subtitle">Đăng ký đối tượng cần được hỗ trợ</div>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="card panel" style="max-width: 600px;">
                <div class="panel-head">
                    <div>
                        <div class="panel-title">Thông tin đối tượng</div>
                        <div class="panel-sub">Điền đầy đủ thông tin bên dưới</div>
                    </div>
                </div>

                <form asp-action="CreateBeneficiary" method="post" class="form">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">Họ và tên <span class="required">*</span></label>
                        <input type="text" name="FullName" class="form-control" required placeholder="Nhập họ tên đầy đủ" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Loại đối tượng <span class="required">*</span></label>
                        <select name="BeneficiaryType" class="form-control" required>
                            <option value="">-- Chọn loại --</option>
                            <option value="Hộ nghèo">Hộ nghèo</option>
                            <option value="Hộ cận nghèo">Hộ cận nghèo</option>
                            <option value="Người khuyết tật">Người khuyết tật</option>
                            <option value="Trẻ em mồ côi">Trẻ em mồ côi</option>
                            <option value="Người già neo đơn">Người già neo đơn</option>
                            <option value="Bệnh nhân nghèo">Bệnh nhân nghèo</option>
                            <option value="Học sinh khó khăn">Học sinh khó khăn</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Địa chỉ</label>
                        <input type="text" name="Address" class="form-control" placeholder="Nhập địa chỉ (nếu có)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mô tả hoàn cảnh</label>
                        <textarea name="Description" class="form-control" rows="4" placeholder="Mô tả ngắn gọn hoàn cảnh của đối tượng..."></textarea>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Beneficiaries" class="btn btn-secondary">← Quay lại</a>
                        <button type="submit" class="btn btn-primary">Thêm mới</button>
                    </div>
                </form>
            </div>
        </section>
    </main>
</div>

<style>
    .menu-section { padding: 8px 16px; font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; margin-top: 8px; }
    .form { padding: 1.5rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-weight: 500; margin-bottom: 0.5rem; color: #e0e0e0; }
    .required { color: #ff6b6b; }
    .form-control { 
        width: 100%; 
        padding: 10px 14px; 
        border: 1px solid #4a4a5a; 
        border-radius: 6px; 
        font-size: 14px; 
        background: #2a2a3a;
        color: #fff;
    }
    .form-control:focus { 
        outline: none; 
        border-color: #6ee7ff; 
        box-shadow: 0 0 0 3px rgba(110, 231, 255, 0.15); 
    }
    .form-control::placeholder { color: #8a8a9a; }
    .form-control option { background: #2a2a3a; color: #fff; }
    .form-actions { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn { padding: 10px 20px; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; text-decoration: none; border: none; }
    .btn-primary { background: linear-gradient(135deg, #6ee7ff 0%, #4fb3ff 100%); color: #1a1a2e; }
    .btn-primary:hover { background: linear-gradient(135deg, #8ff0ff 0%, #6bc5ff 100%); }
    .btn-secondary { background: #3a3a4a; color: #e0e0e0; }
    .btn-secondary:hover { background: #4a4a5a; }
    
    /* Validation styles */
    .form-control.invalid { 
        border-color: #ff6b6b !important; 
        box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.15) !important;
        animation: shake 0.4s ease-in-out;
    }
    .error-message { 
        color: #ff6b6b; 
        font-size: 12px; 
        margin-top: 4px; 
        display: none; 
    }
    .error-message.show { display: block; }
    
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-5px); }
        40%, 80% { transform: translateX(5px); }
    }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
    
    // Form validation
    document.querySelector('form.form')?.addEventListener('submit', function(e) {
        let isValid = true;
        
        // Clear previous errors
        this.querySelectorAll('.form-control').forEach(el => el.classList.remove('invalid'));
        this.querySelectorAll('.error-message').forEach(el => el.classList.remove('show'));
        
        // Required fields validation
        const requiredFields = this.querySelectorAll('[required]');
        requiredFields.forEach(field => {
            if (!field.value.trim()) {
                field.classList.add('invalid');
                const errorEl = field.parentElement.querySelector('.error-message');
                if (errorEl) errorEl.classList.add('show');
                isValid = false;
            }
        });
        
        // Beneficiary type validation
        const beneficiaryType = this.querySelector('[name="BeneficiaryType"]');
        if (beneficiaryType && !beneficiaryType.value) {
            beneficiaryType.classList.add('invalid');
            isValid = false;
        }
        
        if (!isValid) {
            e.preventDefault();
            this.querySelector('.invalid')?.focus();
        }
    });
    
    // Real-time validation feedback
    document.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('input', function() {
            if (this.value.trim()) {
                this.classList.remove('invalid');
                const errorEl = this.parentElement.querySelector('.error-message');
                if (errorEl) errorEl.classList.remove('show');
            }
        });
    });
</script>
