@model List<QLDuLichRBAC_Upgrade.Models.Entities.Notification>
@{
    ViewData["Title"] = "Thông Báo";
    var fullName = ViewData["FullName"]?.ToString() ?? "Nhân viên";
    var pendingInvitations = ViewData["PendingInvitations"] as List<QLDuLichRBAC_Upgrade.Models.Entities.SupportHelper> ?? new();
}

@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">S</div>
            <div class="brand-text">
                <div class="brand-name">Nhân Viên</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Staff" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>
            <a class="menu-item active" asp-controller="Staff" asp-action="Notifications">
                <span class="mi-ico">🔔</span>
                <span class="mi-text">Thông báo</span>
                @if (Model.Count(n => !n.IsRead) > 0)
                {
                    <span class="badge">@Model.Count(n => !n.IsRead)</span>
                }
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="MyTasks">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Công việc của tôi</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Donors">
                <span class="mi-ico">👥</span>
                <span class="mi-text">Nhà tài trợ</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Beneficiaries">
                <span class="mi-ico">🤝</span>
                <span class="mi-text">Người thụ hưởng</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Donations">
                <span class="mi-ico">💰</span>
                <span class="mi-text">Khoản đóng góp</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Requests">
                <span class="mi-ico">📝</span>
                <span class="mi-text">Yêu cầu hỗ trợ</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Thông Báo</div>
                    <div class="subtitle">Xem thông báo và công việc được phân công</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Nhân Viên</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            @if (TempData["Success"] != null)
            {
                <div style="padding: 1rem; background: #22c55e; color: white; border-radius: 8px; margin-bottom: 1rem;">
                    ✓ @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div style="padding: 1rem; background: #dc2626; color: white; border-radius: 8px; margin-bottom: 1rem;">
                    ⚠️ @TempData["Error"]
                </div>
            }

            @* Hiển thị lời mời hỗ trợ đang chờ *@
            @if (pendingInvitations.Any())
            {
                <div class="card panel" style="margin-bottom: 1.5rem; border: 2px solid #f59e0b;">
                    <div class="panel-head" style="background: #f59e0b20;">
                        <div class="panel-title" style="color: #f59e0b;">🆘 Lời mời hỗ trợ (@pendingInvitations.Count)</div>
                    </div>
                    <div style="padding: 1rem;">
                        @foreach (var inv in pendingInvitations)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: #1e293b; border-radius: 8px; margin-bottom: 0.5rem;">
                                <div>
                                    <div style="font-weight: 600; color: #f8fafc;">
                                        Hỗ trợ @inv.Task?.AssignedStaff?.FullName
                                    </div>
                                    <div style="color: #94a3b8; font-size: 0.9rem;">
                                        Công việc: @inv.Task?.SupportRequest?.Beneficiary?.FullName
                                    </div>
                                    <div style="color: #64748b; font-size: 0.8rem;">
                                        Mời lúc: @inv.InvitedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                                <div style="display: flex; gap: 0.5rem;">
                                    <form method="post" asp-action="AcceptHelperInvitation" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="helperId" value="@inv.HelperId" />
                                        <button type="submit" class="btn-action" style="background: #22c55e; color: white; padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer;">
                                            ✓ Chấp nhận
                                        </button>
                                    </form>
                                    <button type="button" onclick="declineInvitation(@inv.HelperId)" class="btn-action" style="background: #ef4444; color: white; padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer;">
                                        ✗ Từ chối
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.Count == 0 && !pendingInvitations.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">🔔</div>
                    <div class="empty-text">Không có thông báo nào</div>
                </div>
            }
            else if (Model.Any())
            {
                <div class="notification-list">
                    @foreach (var n in Model.OrderByDescending(x => x.CreatedAt))
                    {
                        var typeIcon = n.Type switch
                        {
                            "TaskAssigned" => "📋",
                            "TaskCompleted" => "✅",
                            "TaskVerified" => "🎉",
                            "NewPayment" => "💰",
                            "Complaint" => "⚠️",
                            "Công việc mới" => "📋",
                            "Phản hồi hỗ trợ" => "✅",
                            "Từ chối hỗ trợ" => "❌",
                            "Lời mời hỗ trợ" => "🤝",
                            _ => "📢"
                        };
                        
                        var isRejected = n.Type.Contains("Từ chối");
                        
                        <div class="notif-item @(n.IsRead ? "" : "unread") @(isRejected ? "rejected" : "")">
                            <div class="notif-icon @(isRejected ? "icon-rejected" : "")">@typeIcon</div>
                            <div class="notif-content">
                                <div class="notif-title">@n.Title</div>
                                <div class="notif-message">@n.Message</div>
                                <div class="notif-time">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="notif-actions">
                                @if ((n.Type == "TaskAssigned" || n.Type == "Công việc mới") && n.RelatedTaskId.HasValue)
                                {
                                    <a href="@Url.Action("MyTasks", "Staff")" class="btn-action">Xem công việc</a>
                                }
                                @if (n.Type == "Lời mời hỗ trợ" && n.RelatedTaskId.HasValue)
                                {
                                    @* Kiểm tra xem đã phản hồi chưa *@
                                    <form method="post" asp-action="AcceptHelperInvitation" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="helperId" value="@n.RelatedTaskId" />
                                        <button type="button" class="btn-action btn-accept" onclick="acceptInvitation(@n.NotificationId, @n.RelatedTaskId)">✓ Chấp nhận</button>
                                    </form>
                                    <button type="button" class="btn-action btn-decline" onclick="declineInvitation(@n.NotificationId, @n.RelatedTaskId)">✗ Từ chối</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </main>
</div>

<style>
    .badge {
        background: #ef4444;
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        margin-left: auto;
    }

    .notification-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 20px;
        background: linear-gradient(145deg, #1e1e2e, #252538);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s;
    }

    .notif-item.unread {
        background: linear-gradient(145deg, #1e2040, #252560);
        border-left: 3px solid #6366f1;
    }

    .notif-item.rejected {
        background: linear-gradient(145deg, #2a1a1a, #382020);
        border-left: 3px solid #ef4444;
    }

    .notif-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        font-size: 24px;
    }

    .notif-icon.icon-rejected {
        background: rgba(239, 68, 68, 0.2);
    }

    .notif-content {
        flex: 1;
    }

    .notif-title {
        font-size: 16px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 4px;
    }

    .notif-message {
        font-size: 14px;
        color: #a0a0b0;
        line-height: 1.5;
    }

    .notif-time {
        margin-top: 8px;
        font-size: 12px;
        color: #808090;
    }

    .notif-actions {
        display: flex;
        align-items: center;
    }

    .btn-action {
        padding: 10px 16px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
    }

    .btn-action:hover {
        transform: scale(1.02);
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 20px;
    }

    .empty-text {
        font-size: 18px;
        color: #808090;
    }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });

    function declineInvitation(helperId) {
        var note = prompt('Nhập lý do từ chối (tùy chọn):');
        if (note === null) return; // User cancelled
        
        // Tạo form ẩn và submit
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Staff/DeclineHelperInvitation';
        
        var inputId = document.createElement('input');
        inputId.type = 'hidden';
        inputId.name = 'helperId';
        inputId.value = helperId;
        form.appendChild(inputId);
        
        var inputNote = document.createElement('input');
        inputNote.type = 'hidden';
        inputNote.name = 'note';
        inputNote.value = note || '';
        form.appendChild(inputNote);
        
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            var inputToken = document.createElement('input');
            inputToken.type = 'hidden';
            inputToken.name = '__RequestVerificationToken';
            inputToken.value = token.value;
            form.appendChild(inputToken);
        }
        
        document.body.appendChild(form);
        form.submit();
    }
</script>
