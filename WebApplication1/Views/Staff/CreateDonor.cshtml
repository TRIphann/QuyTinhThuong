@{
    ViewData["Title"] = "Thêm Nhà Hảo Tâm";
    var fullName = ViewData["FullName"]?.ToString() ?? "Nhân viên";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">S</div>
            <div class="brand-text">
                <div class="brand-name">Nhân Viên</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Staff" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>
            <div class="menu-section">Quyên góp</div>
            <a class="menu-item active" asp-controller="Staff" asp-action="Donors">
                <span class="mi-ico">👥</span>
                <span class="mi-text">Nhà hảo tâm</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Donations">
                <span class="mi-ico">💵</span>
                <span class="mi-text">Tiếp nhận quyên góp</span>
            </a>
            <div class="menu-section">Hỗ trợ</div>
            <a class="menu-item" asp-controller="Staff" asp-action="Beneficiaries">
                <span class="mi-ico">🧑‍🤝‍🧑</span>
                <span class="mi-text">Đối tượng hỗ trợ</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Requests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Yêu cầu hỗ trợ</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Thêm Nhà Hảo Tâm</div>
                    <div class="subtitle">Đăng ký nhà hảo tâm mới vào hệ thống</div>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="card panel" style="max-width: 600px;">
                <div class="panel-head">
                    <div>
                        <div class="panel-title">Thông tin nhà hảo tâm</div>
                        <div class="panel-sub">Điền đầy đủ thông tin bên dưới</div>
                    </div>
                </div>

                <form asp-action="CreateDonor" method="post" class="form">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">Tên nhà hảo tâm <span class="required">*</span></label>
                        <input type="text" name="DonorName" class="form-control" required placeholder="Nhập tên cá nhân hoặc tổ chức" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Loại <span class="required">*</span></label>
                        <select name="DonorType" class="form-control" required>
                            <option value="">-- Chọn loại --</option>
                            <option value="Cá nhân">Cá nhân</option>
                            <option value="Doanh nghiệp">Doanh nghiệp</option>
                            <option value="Tổ chức">Tổ chức</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Địa chỉ</label>
                        <input type="text" name="Address" class="form-control" placeholder="Nhập địa chỉ (nếu có)" />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Điện thoại</label>
                            <input type="text" name="Phone" class="form-control" placeholder="Số điện thoại" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="Địa chỉ email" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Donors" class="btn btn-secondary">← Quay lại</a>
                        <button type="submit" class="btn btn-primary">Thêm mới</button>
                    </div>
                </form>
            </div>
        </section>
    </main>
</div>

<style>
    .menu-section { padding: 8px 16px; font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; margin-top: 8px; }
    .form { padding: 1.5rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-weight: 500; margin-bottom: 0.5rem; color: #e5e7eb; }
    .required { color: #ff5c7a; }
    .form-control { width: 100%; padding: 10px 14px; border: 1px solid #4a4a5a; border-radius: 6px; font-size: 14px; background: #2a2a3a; color: #fff; }
    .form-control:focus { outline: none; border-color: #6ee7ff; box-shadow: 0 0 0 3px rgba(110, 231, 255, 0.15); }
    .form-control::placeholder { color: #9ca3af; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-actions { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn { padding: 10px 20px; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; text-decoration: none; border: none; }
    .btn-primary { background: linear-gradient(135deg, #6ee7ff, #a78bfa); color: #0b1020; }
    .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-secondary { background: rgba(255,255,255,0.1); color: #e5e7eb; }
    .btn-secondary:hover { background: rgba(255,255,255,0.15); }
    .form-error { color: #ff5c7a; font-size: 12px; margin-top: 4px; display: none; }
    .form-control.invalid { border-color: #ff5c7a !important; animation: shake 0.4s ease-in-out; }
    .form-control.invalid + .form-error { display: block; }
    @@keyframes shake { 0%, 100% { transform: translateX(0); } 10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); } 20%, 40%, 60%, 80% { transform: translateX(4px); } }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });

    // Form validation
    document.querySelector('form.form')?.addEventListener('submit', function(e) {
        let isValid = true;
        const requiredFields = this.querySelectorAll('[required]');
        
        requiredFields.forEach(field => {
            field.classList.remove('invalid');
            if (!field.value.trim()) {
                field.classList.add('invalid');
                isValid = false;
            }
        });

        // Validate email format
        const emailField = this.querySelector('input[type="email"]');
        if (emailField && emailField.value && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(emailField.value)) {
            emailField.classList.add('invalid');
            isValid = false;
        }

        // Validate phone format
        const phoneField = this.querySelector('input[name="Phone"]');
        if (phoneField && phoneField.value && !/^[0-9]{10,11}$/.test(phoneField.value.replace(/\s/g, ''))) {
            phoneField.classList.add('invalid');
            isValid = false;
        }

        if (!isValid) {
            e.preventDefault();
            const firstInvalid = this.querySelector('.invalid');
            firstInvalid?.focus();
        }
    });

    // Remove invalid state on input
    document.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('input', function() {
            this.classList.remove('invalid');
        });
    });
</script>
