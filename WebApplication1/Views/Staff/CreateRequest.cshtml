@{
    ViewData["Title"] = "Tạo Yêu Cầu Hỗ Trợ";
    var fullName = ViewData["FullName"]?.ToString() ?? "Nhân viên";
    var beneficiaries = ViewData["Beneficiaries"] as IEnumerable<dynamic>;
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">S</div>
            <div class="brand-text">
                <div class="brand-name">Nhân Viên</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Staff" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>
            <div class="menu-section">Quyên góp</div>
            <a class="menu-item" asp-controller="Staff" asp-action="Donors">
                <span class="mi-ico">👥</span>
                <span class="mi-text">Nhà hảo tâm</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Donations">
                <span class="mi-ico">💵</span>
                <span class="mi-text">Tiếp nhận quyên góp</span>
            </a>
            <div class="menu-section">Hỗ trợ</div>
            <a class="menu-item" asp-controller="Staff" asp-action="Beneficiaries">
                <span class="mi-ico">🧑‍🤝‍🧑</span>
                <span class="mi-text">Đối tượng hỗ trợ</span>
            </a>
            <a class="menu-item active" asp-controller="Staff" asp-action="Requests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Yêu cầu hỗ trợ</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Tạo Yêu Cầu Hỗ Trợ</div>
                    <div class="subtitle">Lập hồ sơ đề nghị hỗ trợ cho đối tượng</div>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="card panel" style="max-width: 600px;">
                <div class="panel-head">
                    <div>
                        <div class="panel-title">Thông tin yêu cầu</div>
                        <div class="panel-sub">Điền đầy đủ thông tin bên dưới</div>
                    </div>
                </div>

                <form asp-action="CreateRequest" method="post" class="form">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">Đối tượng hỗ trợ <span class="required">*</span></label>
                        <select name="BeneficiaryId" class="form-control" required>
                            <option value="">-- Chọn đối tượng --</option>
                            @if (beneficiaries != null)
                            {
                                foreach (var b in beneficiaries)
                                {
                                    <option value="@b.BeneficiaryId">@b.FullName (@b.BeneficiaryType)</option>
                                }
                            }
                        </select>
                        <small class="form-hint">Chưa có? <a asp-action="CreateBeneficiary">Thêm đối tượng mới</a></small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Số tiền đề nghị <span class="required">*</span></label>
                        <input type="number" name="RequestedAmount" class="form-control" required min="1000" placeholder="Nhập số tiền (VND)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Lý do hỗ trợ</label>
                        <textarea name="Reason" class="form-control" rows="4" placeholder="Mô tả lý do cần hỗ trợ..."></textarea>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Requests" class="btn btn-secondary">← Quay lại</a>
                        <button type="submit" class="btn btn-primary">Tạo yêu cầu</button>
                    </div>
                </form>
            </div>
        </section>
    </main>
</div>

<style>
    .menu-section { padding: 8px 16px; font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; margin-top: 8px; }
    .form { padding: 1.5rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-weight: 500; margin-bottom: 0.5rem; color: #e5e7eb; }
    .required { color: #ff5c7a; }
    .form-control { width: 100%; padding: 10px 14px; border: 1px solid #4a4a5a; border-radius: 6px; font-size: 14px; background: #2a2a3a; color: #fff; }
    .form-control:focus { outline: none; border-color: #6ee7ff; box-shadow: 0 0 0 3px rgba(110, 231, 255, 0.15); }
    .form-control::placeholder { color: #9ca3af; }
    .form-hint { display: block; margin-top: 6px; font-size: 12px; color: #9ca3af; }
    .form-hint a { color: #6ee7ff; }
    .form-actions { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn { padding: 10px 20px; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; text-decoration: none; border: none; }
    .btn-primary { background: linear-gradient(135deg, #6ee7ff, #a78bfa); color: #0b1020; }
    .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-secondary { background: rgba(255,255,255,0.1); color: #e5e7eb; }
    .btn-secondary:hover { background: rgba(255,255,255,0.15); }
    .form-control.invalid { border-color: #ff5c7a !important; animation: shake 0.4s ease-in-out; }
    @@keyframes shake { 0%, 100% { transform: translateX(0); } 10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); } 20%, 40%, 60%, 80% { transform: translateX(4px); } }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });

    // Form validation
    document.querySelector('form.form')?.addEventListener('submit', function(e) {
        let isValid = true;
        const requiredFields = this.querySelectorAll('[required]');
        
        requiredFields.forEach(field => {
            field.classList.remove('invalid');
            if (!field.value.trim() || (field.tagName === 'SELECT' && !field.value)) {
                field.classList.add('invalid');
                isValid = false;
            }
        });

        // Validate amount > 0
        const amountField = this.querySelector('input[name="RequestedAmount"]');
        if (amountField && (isNaN(amountField.value) || parseFloat(amountField.value) < 1000)) {
            amountField.classList.add('invalid');
            isValid = false;
        }

        if (!isValid) {
            e.preventDefault();
            const firstInvalid = this.querySelector('.invalid');
            firstInvalid?.focus();
        }
    });

    document.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('input', function() { this.classList.remove('invalid'); });
        input.addEventListener('change', function() { this.classList.remove('invalid'); });
    });
</script>
