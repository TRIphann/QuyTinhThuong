@{
    ViewData["Title"] = "Tạo Yêu Cầu Hỗ Trợ";
    var fullName = ViewData["FullName"]?.ToString() ?? "Nhân viên";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <partial name="_StaffSidebar" />

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Tạo Yêu Cầu Hỗ Trợ</div>
                    <div class="subtitle">Tạo hồ sơ cho người cần hỗ trợ</div>
                </div>
            </div>
            <div class="topbar-right">
                <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
            </div>
        </header>

        <section class="content">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" style="background: #ef444420; color: #ef4444; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
                    @TempData["Error"]
                </div>
            }

            <div class="card panel" style="max-width: 800px;">
                <div class="panel-head">
                    <div>
                        <div class="panel-title">📝 Thông tin yêu cầu hỗ trợ</div>
                        <div class="panel-sub">Điền đầy đủ thông tin người cần hỗ trợ</div>
                    </div>
                </div>

                <form method="post" asp-action="CreateRequest" style="padding: 1.5rem;">
                    @Html.AntiForgeryToken()

                    <!-- Thông tin người cần hỗ trợ -->
                    <div style="background: #1e293b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <h4 style="color: #f8fafc; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                            <span>👤</span> Thông tin người cần hỗ trợ
                        </h4>
                        
                        <div style="margin-bottom: 1rem;">
                            <label style="color: #f8fafc; display: block; margin-bottom: 0.5rem;">
                                Họ và tên <span style="color: #ef4444;">*</span>
                            </label>
                            <input type="text" name="fullName" required placeholder="Nhập họ tên người cần hỗ trợ..."
                                   style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #0f172a; color: #f8fafc; border: 1px solid #334155;" />
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <label style="color: #f8fafc; display: block; margin-bottom: 0.5rem;">
                                Loại đối tượng <span style="color: #ef4444;">*</span>
                            </label>
                            <select name="beneficiaryType" required 
                                    style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #0f172a; color: #f8fafc; border: 1px solid #334155;">
                                <option value="">-- Chọn loại đối tượng --</option>
                                <option value="Trẻ em mồ côi">Trẻ em mồ côi</option>
                                <option value="Trẻ em khó khăn">Trẻ em khó khăn</option>
                                <option value="Người già neo đơn">Người già neo đơn</option>
                                <option value="Người khuyết tật">Người khuyết tật</option>
                                <option value="Hộ nghèo">Hộ nghèo</option>
                                <option value="Hộ cận nghèo">Hộ cận nghèo</option>
                                <option value="Bệnh nhân hiểm nghèo">Bệnh nhân hiểm nghèo</option>
                                <option value="Nạn nhân thiên tai">Nạn nhân thiên tai</option>
                                <option value="Học sinh sinh viên nghèo">Học sinh sinh viên nghèo</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <label style="color: #f8fafc; display: block; margin-bottom: 0.5rem;">
                                Địa chỉ
                            </label>
                            <input type="text" name="address" placeholder="Nhập địa chỉ..."
                                   style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #0f172a; color: #f8fafc; border: 1px solid #334155;" />
                        </div>
                    </div>

                    <!-- Vấn đề cần hỗ trợ -->
                    <div style="background: #1e293b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <h4 style="color: #f8fafc; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                            <span>📋</span> Chi tiết yêu cầu hỗ trợ
                        </h4>

                        <div style="margin-bottom: 1rem;">
                            <label style="color: #f8fafc; display: block; margin-bottom: 0.5rem;">
                                Vấn đề cần hỗ trợ <span style="color: #ef4444;">*</span>
                            </label>
                            <textarea name="supportIssue" required rows="3" 
                                      placeholder="Mô tả chi tiết vấn đề mà người này đang gặp phải cần được hỗ trợ..."
                                      style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #0f172a; color: #f8fafc; border: 1px solid #334155;"></textarea>
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <label style="color: #f8fafc; display: block; margin-bottom: 0.5rem;">
                                Lý do hỗ trợ
                            </label>
                            <textarea name="reason" rows="2" 
                                      placeholder="Lý do cần được hỗ trợ (nếu có)..."
                                      style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #0f172a; color: #f8fafc; border: 1px solid #334155;"></textarea>
                        </div>
                    </div>

                    <!-- Lưu ý -->
                    <div style="background: #3b82f620; border: 1px solid #3b82f6; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <div style="display: flex; gap: 0.5rem; color: #60a5fa;">
                            <span>ℹ️</span>
                            <div>
                                <strong>Lưu ý:</strong> Yêu cầu hỗ trợ sau khi tạo sẽ được gửi đến quản lý để xét duyệt. 
                                Số tiền hỗ trợ sẽ được quản lý quyết định dựa trên tình hình thực tế và nguồn quỹ hiện có.
                            </div>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" 
                                style="flex: 1; padding: 0.875rem; background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; font-size: 1rem;">
                            📤 Gửi yêu cầu hỗ trợ
                        </button>
                        <a asp-action="Index" 
                           style="padding: 0.875rem 1.5rem; background: #475569; color: white; border: none; border-radius: 8px; text-decoration: none; text-align: center;">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </section>
    </main>
</div>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
