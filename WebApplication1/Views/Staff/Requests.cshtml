@model List<QLDuLichRBAC_Upgrade.Models.ViewModels.SupportRequestVm>
@{
    ViewData["Title"] = "Yêu Cầu Hỗ Trợ";
    var fullName = ViewData["FullName"]?.ToString() ?? "Nhân viên";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">S</div>
            <div class="brand-text">
                <div class="brand-name">Nhân Viên</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Staff" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>
            <div class="menu-section">Quyên góp</div>
            <a class="menu-item" asp-controller="Staff" asp-action="Donors">
                <span class="mi-ico">👥</span>
                <span class="mi-text">Nhà hảo tâm</span>
            </a>
            <a class="menu-item" asp-controller="Staff" asp-action="Donations">
                <span class="mi-ico">💵</span>
                <span class="mi-text">Tiếp nhận quyên góp</span>
            </a>
            <div class="menu-section">Hỗ trợ</div>
            <a class="menu-item" asp-controller="Staff" asp-action="Beneficiaries">
                <span class="mi-ico">🧑‍🤝‍🧑</span>
                <span class="mi-text">Đối tượng hỗ trợ</span>
            </a>
            <a class="menu-item active" asp-controller="Staff" asp-action="Requests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Yêu cầu hỗ trợ</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Danh Sách Yêu Cầu Hỗ Trợ</div>
                    <div class="subtitle">Tổng: @Model.Count yêu cầu</div>
                </div>
            </div>
            <div class="topbar-right">
                <a asp-action="CreateRequest" class="btn btn-primary">+ Tạo yêu cầu mới</a>
            </div>
        </header>

        <section class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="card panel">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Đối tượng</th>
                            <th>Loại</th>
                            <th>Số tiền</th>
                            <th>Ngày tạo</th>
                            <th>Lý do</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td>@req.RequestId</td>
                                <td><strong>@req.BeneficiaryName</strong></td>
                                <td><span class="chip">@req.BeneficiaryType</span></td>
                                <td><strong>@req.RequestedAmount.ToString("N0") VND</strong></td>
                                <td>@req.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(req.Reason ?? "-")</td>
                                <td>
                                    @if (req.Status == "Chờ xét duyệt")
                                    {
                                        <span class="badge bg-warning text-dark">@req.Status</span>
                                    }
                                    else if (req.Status == "Đã duyệt" || req.Status == "Đã chi")
                                    {
                                        <span class="badge bg-success">@req.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@req.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<style>
    .menu-section { padding: 8px 16px; font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; margin-top: 8px; }
    .table { width: 100%; border-collapse: collapse; }
    .table th, .table td { padding: 12px; text-align: left; border-bottom: 1px solid #3a3a4a; color: #ffffff !important; }
    .table th { background: #2a2a3a; font-weight: 600; color: #e0e0e0 !important; border-top: 2px solid #5a5a6a; }
    .table td { color: #ffffff !important; }
    .table td strong { color: #ffffff !important; }
    .badge { padding: 4px 10px; border-radius: 4px; font-size: 12px; }
    .bg-warning { background: #ffc107; color: #333 !important; }
    .bg-success { background: #28a745; color: white !important; }
    .bg-danger { background: #dc3545; color: white !important; }
    .text-dark { color: #333; }
    .btn { padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; }
    .btn-primary { background: #4f46e5; color: white; }
    .btn-primary:hover { background: #4338ca; }
    .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 1rem; }
    .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
