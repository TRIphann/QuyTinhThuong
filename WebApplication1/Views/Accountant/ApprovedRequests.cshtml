@model List<QLDuLichRBAC_Upgrade.Models.ViewModels.SupportRequestVm>
@{
    ViewData["Title"] = "Hồ Sơ Đã Duyệt";
    var fullName = ViewData["FullName"]?.ToString() ?? "Kế toán";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">K</div>
            <div class="brand-text">
                <div class="brand-name">Accountant Panel</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Accountant" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Dashboard</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Donations">
                <span class="mi-ico">💵</span>
                <span class="mi-text">Danh sách quyên góp</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Expenses">
                <span class="mi-ico">💸</span>
                <span class="mi-text">Danh sách chi</span>
            </a>
            <a class="menu-item active" asp-controller="Accountant" asp-action="ApprovedRequests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Hồ sơ đã duyệt</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Reports">
                <span class="mi-ico">📊</span>
                <span class="mi-text">Báo cáo tài chính</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Hồ Sơ Đã Duyệt</div>
                    <div class="subtitle">Các yêu cầu đã được phê duyệt, sẵn sàng chi tiền</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Kế Toán</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="card panel">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Đối tượng</th>
                            <th>Loại</th>
                            <th>Số tiền</th>
                            <th>Ngày tạo</th>
                            <th>Lý do</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td>@req.RequestId</td>
                                <td><strong>@req.BeneficiaryName</strong></td>
                                <td><span class="chip">@req.BeneficiaryType</span></td>
                                <td><strong>@req.RequestedAmount.ToString("N0") VND</strong></td>
                                <td>@req.RequestDate.ToString("dd/MM/yyyy")</td>
                                <td>@(req.Reason ?? "-")</td>
                                <td>
                                    <a asp-action="CreateExpense" asp-route-id="@req.RequestId" class="btn btn-sm btn-primary">Chi tiền</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center muted">Không có hồ sơ nào đã duyệt</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<style>
    .table { width: 100%; border-collapse: collapse; }
    .table th, .table td { padding: 12px; text-align: left; border-bottom: 1px solid #3a3a4a; color: #ffffff !important; }
    .table th { background: #2a2a3a; font-weight: 600; color: #e0e0e0 !important; border-top: 2px solid #5a5a6a; }
    .table td { color: #ffffff !important; }
    .table td strong { color: #ffffff !important; }
    .text-center { text-align: center; }
    .btn { padding: 6px 14px; border-radius: 4px; text-decoration: none; font-size: 13px; }
    .btn-primary { background: #4f46e5; color: white; }
    .btn-primary:hover { background: #4338ca; }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
