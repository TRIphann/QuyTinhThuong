@model List<QLDuLichRBAC_Upgrade.Models.ViewModels.ExpenseVm>
@{
    ViewData["Title"] = "Danh Sách Chi";
    var fullName = ViewData["FullName"]?.ToString() ?? "Kế toán";
    var totalAmount = ViewData["TotalAmount"] as decimal? ?? 0;
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">K</div>
            <div class="brand-text">
                <div class="brand-name">Accountant Panel</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Accountant" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Dashboard</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Donations">
                <span class="mi-ico">💵</span>
                <span class="mi-text">Danh sách quyên góp</span>
            </a>
            <a class="menu-item active" asp-controller="Accountant" asp-action="Expenses">
                <span class="mi-ico">💸</span>
                <span class="mi-text">Danh sách chi</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="ApprovedRequests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Hồ sơ đã duyệt</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Reports">
                <span class="mi-ico">📊</span>
                <span class="mi-text">Báo cáo tài chính</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Danh Sách Chi Tiêu</div>
                    <div class="subtitle">Tổng: @totalAmount.ToString("N0") VND từ @Model.Count khoản</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Kế Toán</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="card panel">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Đối tượng hỗ trợ</th>
                            <th>Số tiền</th>
                            <th>Ngày chi</th>
                            <th>Phương thức</th>
                            <th>Người chi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>@e.ExpenseId</td>
                                <td><strong>@e.BeneficiaryName</strong></td>
                                <td class="text-danger"><strong>@e.Amount.ToString("N0") VND</strong></td>
                                <td>@e.ExpenseDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@e.PaymentMethod</td>
                                <td>@(e.PaidByName ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<style>
    .table { width: 100%; border-collapse: collapse; }
    .table th, .table td { padding: 12px; text-align: left; border-bottom: 1px solid #e5e7eb; }
    .table th { background: #f9fafb; font-weight: 600; }
    .text-danger { color: #ef4444; }
    .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 1rem; }
    .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
