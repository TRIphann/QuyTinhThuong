@{
    ViewData["Title"] = "Quyên góp";
    var fullName = ViewBag.FullName as string ?? "Tình nguyện viên";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <!-- Sidebar -->
    <partial name="_AccountantSidebar" />

    <!-- Main -->
    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar" title="Thu gọn sidebar">☰</button>
                <div class="page-title">
                    <div class="title">Quyên góp vào quỹ</div>
                    <div class="subtitle">Đóng góp vào Quỹ Tình Thương qua chuyển khoản</div>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="card panel" style="max-width: 600px; margin: 0 auto;">
                <div class="panel-head" style="text-align: center;">
                    <div>
                        <div class="panel-title">Quét mã QR để quyên góp</div>
                        <div class="panel-sub">Sử dụng ứng dụng ngân hàng để quét</div>
                    </div>
                </div>

                <div style="padding: 2rem; text-align: center;">
                    <!-- Nhập số tiền -->
                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label style="color: #f8fafc; display: block; margin-bottom: 0.5rem; font-size: 1rem;">Số tiền quyên góp <span style="color: #ef4444;">*</span></label>
                        <input type="number" name="amount" id="amountInput" required min="1000" value="100000" placeholder="Nhập số tiền (VND)"
                               style="width: 100%; max-width: 300px; padding: 0.75rem; border-radius: 8px; background: #1e293b; color: #f8fafc; border: 1px solid #334155; text-align: center; font-size: 1.1rem;" />
                        <small style="color: #64748b; display: block; margin-top: 0.5rem;">Tối thiểu 1,000 VND</small>
                    </div>

                    <!-- QR Code -->
                    <div id="qrLoading" style="display: none; color: #64748b; padding: 2rem;">
                        <p>⏳ Đang tạo mã QR...</p>
                    </div>
                    <div style="display: flex; justify-content: center;">
                        <img id="qrCodeImage" src="" alt="QR Code" style="max-width: 280px; border-radius: 12px; background: white; padding: 1rem; display: none;" />
                    </div>
                    <p id="qrError" style="color: #64748b; display: none;">Nhập số tiền để tạo mã QR</p>

                    <div style="margin-top: 1.5rem; color: #94a3b8;">
                        <p><strong style="color: #f8fafc;">Thông tin chuyển khoản:</strong></p>
                        <p style="margin-top: 0.5rem;">Ngân hàng: <strong>MB Bank</strong></p>
                        <p>Số tài khoản: <strong>1518893947588</strong></p>
                        <p>Chủ TK: <strong>PHAN CONG TRI</strong></p>
                        <p id="qrAmount" style="margin-top: 1rem; color: #22c55e; font-size: 1.2rem; font-weight: bold; display: none;"></p>
                    </div>

                    <!-- Nút xác nhận -->
                    <form method="post" asp-action="ConfirmDonation" style="margin-top: 1.5rem;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="amount" id="hiddenAmount" value="100000" />
                        <button type="submit" style="width: 100%; max-width: 300px; padding: 0.75rem; background: #22c55e; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 1rem;">
                            ✓ Xác nhận đã chuyển khoản
                        </button>
                    </form>
                </div>
            </div>

            <div class="card panel" style="margin-top: 1rem;">
                <div style="padding: 1.5rem; color: #94a3b8;">
                    <h4 style="color: #f8fafc; margin-bottom: 0.5rem;">❤️ Lưu ý khi quyên góp</h4>
                    <ul style="list-style: disc; padding-left: 1.5rem; line-height: 1.8;">
                        <li>Mọi khoản quyên góp đều được quản lý minh bạch</li>
                        <li>Bạn có thể theo dõi lịch sử quyên góp và các hoạt động hỗ trợ đã hoàn thành</li>
                        <li>Sau mỗi đợt hỗ trợ hoàn thành, bạn sẽ nhận được thông báo</li>
                        <li>Bạn có thể gửi góp ý sau 3 ngày kể từ khi hỗ trợ hoàn thành</li>
                    </ul>
                </div>
            </div>
        </section>
    </main>
</div>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });

    // Hàm tạo QR Code khi nhập số tiền
    const amountInput = document.getElementById('amountInput');
    const hiddenAmount = document.getElementById('hiddenAmount');
    const qrCodeImage = document.getElementById('qrCodeImage');
    const qrLoading = document.getElementById('qrLoading');
    const qrError = document.getElementById('qrError');
    const qrAmount = document.getElementById('qrAmount');
    let debounceTimer;

    // Load QR code với số tiền mặc định khi trang load
    window.addEventListener('load', function() {
        generateQRCode(100000); // Số tiền mặc định 100,000 VND
    });

    amountInput?.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        const amount = parseInt(this.value) || 0;
        
        // Cập nhật hidden input cho form submit
        if (hiddenAmount) {
            hiddenAmount.value = amount;
        }
        
        if (amount >= 1000) {
            debounceTimer = setTimeout(() => generateQRCode(amount), 500);
        } else {
            qrCodeImage.style.display = 'none';
            qrError.style.display = 'block';
            qrError.textContent = 'Nhập số tiền (tối thiểu 1,000 VND) để tạo mã QR';
            qrAmount.style.display = 'none';
        }
    });

    function generateQRCode(amount) {
        qrLoading.style.display = 'block';
        qrCodeImage.style.display = 'none';
        qrError.style.display = 'none';

        fetch(`/Accountant/GetDonateQR?amount=${amount}`)
            .then(response => response.json())
            .then(data => {
                qrLoading.style.display = 'none';
                if (data.success) {
                    qrCodeImage.src = data.qrCode;
                    qrCodeImage.style.display = 'block';
                    qrAmount.textContent = `Số tiền: ${amount.toLocaleString('vi-VN')} VND`;
                    qrAmount.style.display = 'block';
                } else {
                    qrError.textContent = data.message || 'Không thể tạo mã QR';
                    qrError.style.display = 'block';
                }
            })
            .catch(error => {
                qrLoading.style.display = 'none';
                qrError.textContent = 'Lỗi kết nối server';
                qrError.style.display = 'block';
            });
    }
</script>
