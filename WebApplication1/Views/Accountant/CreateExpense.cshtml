@using QLDuLichRBAC_Upgrade.Models.ViewModels
@{
    ViewData["Title"] = "Chi Tiền Hỗ Trợ";
    var fullName = ViewData["FullName"]?.ToString() ?? "Khách hàng";
    var request = ViewData["Request"] as SupportRequestVm;
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">K</div>
            <div class="brand-text">
                <div class="brand-name">Khách Hàng</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Accountant" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Donations">
                <span class="mi-ico">�</span>
                <span class="mi-text">Hỗ trợ người cần</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Expenses">
                <span class="mi-ico">💸</span>
                <span class="mi-text">Danh sách chi</span>
            </a>
            <a class="menu-item active" asp-controller="Accountant" asp-action="ApprovedRequests">
                <span class="mi-ico">📋</span>
                <span class="mi-text">Hồ sơ đã duyệt</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Reports">
                <span class="mi-ico">📊</span>
                <span class="mi-text">Báo cáo tài chính</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Chi Tiền Hỗ Trợ #@request?.RequestId</div>
                    <div class="subtitle">Ghi nhận chi tiền cho yêu cầu đã duyệt</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Khách Hàng</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="grid two-col">
                <!-- Request Info -->
                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Thông tin yêu cầu</div>
                            <div class="panel-sub">Chi tiết hồ sơ đã duyệt</div>
                        </div>
                    </div>

                    <div class="info-list">
                        <div class="info-row">
                            <span class="info-label">Đối tượng:</span>
                            <span class="info-value">@request?.BeneficiaryName</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Loại đối tượng:</span>
                            <span class="info-value"><span class="chip">@request?.BeneficiaryType</span></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Số tiền đề nghị:</span>
                            <span class="info-value"><strong>@(request?.RequestedAmount.HasValue == true ? request.RequestedAmount.Value.ToString("N0") + " VND" : "Chưa xác định")</strong></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Ngày tạo:</span>
                            <span class="info-value">@request?.RequestDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Lý do:</span>
                            <span class="info-value">@(request?.Reason ?? "Không có")</span>
                        </div>
                    </div>
                </div>

                <!-- Payment Form -->
                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Thông tin chi tiền</div>
                            <div class="panel-sub">Nhập thông tin chi tiền</div>
                        </div>
                    </div>

                    <form asp-action="CreateExpense" method="post" class="form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RequestId" value="@request?.RequestId" />

                        <div class="form-group">
                            <label class="form-label">Số tiền chi <span class="required">*</span></label>
                            <input type="number" name="Amount" class="form-control" 
                                   value="@request?.RequestedAmount" min="1" required
                                   placeholder="Nhập số tiền chi" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Phương thức chi <span class="required">*</span></label>
                            <select name="PaymentMethod" class="form-control" required>
                                <option value="">-- Chọn phương thức --</option>
                                <option value="Tiền mặt">Tiền mặt</option>
                                <option value="Chuyển khoản">Chuyển khoản</option>
                                <option value="Séc">Séc</option>
                            </select>
                        </div>

                        <div class="form-actions">
                            <a asp-action="ApprovedRequests" class="btn btn-secondary">← Quay lại</a>
                            <button type="submit" class="btn btn-primary">Xác nhận chi tiền</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </main>
</div>

<style>
    .info-list { padding: 1rem; }
    .info-row { display: flex; padding: 10px 0; border-bottom: 1px solid #3a3a4a; }
    .info-row:last-child { border-bottom: none; }
    .info-label { width: 140px; color: #a0a0b0; font-weight: 500; }
    .info-value { flex: 1; color: #ffffff; }
    .form { padding: 1rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-weight: 500; margin-bottom: 0.5rem; color: #e0e0e0; }
    .required { color: #ff6b6b; }
    .form-control { 
        width: 100%; 
        padding: 10px 14px; 
        border: 1px solid #4a4a5a; 
        border-radius: 6px; 
        font-size: 14px; 
        background: #2a2a3a;
        color: #fff;
    }
    .form-control:focus { 
        outline: none; 
        border-color: #6ee7ff; 
        box-shadow: 0 0 0 3px rgba(110, 231, 255, 0.15); 
    }
    .form-control::placeholder { color: #8a8a9a; }
    .form-control option { background: #2a2a3a; color: #fff; }
    .form-actions { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem; }
    .btn { padding: 10px 20px; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer; text-decoration: none; border: none; }
    .btn-primary { background: linear-gradient(135deg, #6ee7ff 0%, #4fb3ff 100%); color: #1a1a2e; }
    .btn-primary:hover { background: linear-gradient(135deg, #8ff0ff 0%, #6bc5ff 100%); }
    .btn-secondary { background: #3a3a4a; color: #e0e0e0; }
    .btn-secondary:hover { background: #4a4a5a; }
    
    /* Validation styles */
    .form-control.invalid { 
        border-color: #ff6b6b !important; 
        box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.15) !important;
        animation: shake 0.4s ease-in-out;
    }
    .error-message { 
        color: #ff6b6b; 
        font-size: 12px; 
        margin-top: 4px; 
        display: none; 
    }
    .error-message.show { display: block; }
    
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-5px); }
        40%, 80% { transform: translateX(5px); }
    }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
    
    // Form validation
    document.querySelector('form.form')?.addEventListener('submit', function(e) {
        let isValid = true;
        
        // Clear previous errors
        this.querySelectorAll('.form-control').forEach(el => el.classList.remove('invalid'));
        
        // Required fields validation
        const requiredFields = this.querySelectorAll('[required]');
        requiredFields.forEach(field => {
            if (!field.value.trim()) {
                field.classList.add('invalid');
                isValid = false;
            }
        });
        
        // Amount validation (phải > 0)
        const amountField = this.querySelector('[name="Amount"]');
        if (amountField) {
            const amount = parseFloat(amountField.value) || 0;
            if (amount < 1000) {
                amountField.classList.add('invalid');
                isValid = false;
            }
        }
        
        // Payment method validation
        const paymentMethod = this.querySelector('[name="PaymentMethod"]');
        if (paymentMethod && !paymentMethod.value) {
            paymentMethod.classList.add('invalid');
            isValid = false;
        }
        
        if (!isValid) {
            e.preventDefault();
            this.querySelector('.invalid')?.focus();
        }
    });
    
    // Real-time validation feedback
    document.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('input', function() {
            if (this.value.trim()) {
                this.classList.remove('invalid');
            }
        });
    });
</script>
