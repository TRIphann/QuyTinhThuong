@model QLDuLichRBAC_Upgrade.Models.ViewModels.AccountantDashboardVm
@{
    ViewData["Title"] = "Tổng quan Khách Hàng";
    var fullName = string.IsNullOrWhiteSpace(Model.FullName) ? "Khách hàng" : Model.FullName;
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">K</div>
            <div class="brand-text">
                <div class="brand-name">Khách Hàng</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item active" asp-controller="Accountant" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>

            <a class="menu-item" asp-controller="Accountant" asp-action="Donate">
                <span class="mi-ico">💝</span>
                <span class="mi-text">Quyên góp</span>
            </a>

            <a class="menu-item" asp-controller="Accountant" asp-action="MyDonations">
                <span class="mi-ico">📜</span>
                <span class="mi-text">Lịch sử quyên góp</span>
            </a>

            <a class="menu-item" asp-controller="Accountant" asp-action="CompletedSupports">
                <span class="mi-ico">✅</span>
                <span class="mi-text">Hoạt động hỗ trợ</span>
            </a>

            <a class="menu-item" asp-controller="Accountant" asp-action="Notifications">
                <span class="mi-ico">🔔</span>
                <span class="mi-text">Thông báo</span>
                @if (Model.UnreadNotifications > 0)
                {
                    <span class="badge-count">@Model.UnreadNotifications</span>
                }
            </a>

            <div class="menu-divider"></div>

            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>

        <div class="sidebar-footer">
            <div class="badge">
                <div class="dot"></div>
                <span>Hệ thống đang hoạt động</span>
            </div>
            <div class="tiny">© @DateTime.Now.Year</div>
        </div>
    </aside>

    <!-- Main -->
    <main class="main">
        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar" title="Thu gọn sidebar">☰</button>

                <div class="page-title">
                    <div class="title">Tổng quan</div>
                    <div class="subtitle">
                        Xin chào, <strong>@fullName</strong>. Cảm ơn bạn đã đồng hành cùng Quỹ Tình Thương.
                    </div>
                </div>
            </div>

            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Khách Hàng</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <section class="content">
            <!-- Stat cards -->
            <div class="grid stats">
                <div class="card stat glow">
                    <div class="stat-head">
                        <div class="stat-ico">💝</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Tổng quyên góp của bạn</div>
                            <div class="kpi-value text-success">@Model.MyTotalDonations.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">VND</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">📊</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Số lần quyên góp</div>
                            <div class="kpi-value">@Model.MyDonationCount</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">Lần</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">✅</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Hoạt động hoàn thành</div>
                            <div class="kpi-value">@Model.CompletedSupports</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">Đợt hỗ trợ đã hoàn thành</span>
                    </div>
                </div>

                <div class="card stat">
                    <div class="stat-head">
                        <div class="stat-ico">🔔</div>
                        <div class="stat-kpi">
                            <div class="kpi-label">Thông báo mới</div>
                            <div class="kpi-value text-warning">@Model.UnreadNotifications</div>
                        </div>
                    </div>
                    <div class="stat-foot">
                        <span class="muted">Chưa đọc</span>
                    </div>
                </div>
            </div>

            <!-- Quick actions -->
            <div class="grid two-col">
                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Chức năng chính</div>
                            <div class="panel-sub">Truy cập nhanh các tính năng</div>
                        </div>
                        <div class="chip">Thao tác nhanh</div>
                    </div>

                    <div class="actions">
                        <a class="action-card" asp-controller="Accountant" asp-action="Donate">
                            <div class="action-ico">💝</div>
                            <div class="action-body">
                                <div class="action-title">Quyên góp</div>
                                <div class="action-desc">Đóng góp vào quỹ qua chuyển khoản</div>
                            </div>
                            <div class="action-go">→</div>
                        </a>

                        <a class="action-card" asp-controller="Accountant" asp-action="MyDonations">
                            <div class="action-ico">📜</div>
                            <div class="action-body">
                                <div class="action-title">Lịch sử quyên góp</div>
                                <div class="action-desc">Xem các khoản bạn đã đóng góp</div>
                            </div>
                            <div class="action-go">→</div>
                        </a>

                        <a class="action-card" asp-controller="Accountant" asp-action="CompletedSupports">
                            <div class="action-ico">✅</div>
                            <div class="action-body">
                                <div class="action-title">Hoạt động hỗ trợ</div>
                                <div class="action-desc">Xem các đợt hỗ trợ đã hoàn thành</div>
                            </div>
                            <div class="action-go">→</div>
                        </a>
                    </div>
                </div>

                <div class="card panel">
                    <div class="panel-head">
                        <div>
                            <div class="panel-title">Giới thiệu</div>
                            <div class="panel-sub">Quỹ Tình Thương</div>
                        </div>
                        <div class="chip">Thông tin</div>
                    </div>

                    <div class="info-content" style="padding: 1rem;">
                        <p style="color: #94a3b8; line-height: 1.6;">
                            <strong style="color: #f8fafc;">Quỹ Tình Thương</strong> được thành lập với mục đích 
                            hỗ trợ những hoàn cảnh khó khăn trong cộng đồng.
                        </p>
                        <p style="color: #94a3b8; line-height: 1.6; margin-top: 0.5rem;">
                            Mỗi đóng góp của bạn đều được sử dụng minh bạch và đúng mục đích. 
                            Bạn có thể theo dõi các hoạt động hỗ trợ đã hoàn thành và gửi góp ý 
                            để giúp chúng tôi hoạt động tốt hơn.
                        </p>
                        <p style="color: #64748b; font-size: 0.875rem; margin-top: 1rem;">
                            ❤️ Cảm ơn bạn đã tin tưởng và đồng hành!
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

<style>
    .text-success { color: #22c55e; }
    .text-danger { color: #ef4444; }
    .text-warning { color: #f59e0b; }
    .badge-count {
        background: #ef4444;
        color: white;
        border-radius: 10px;
        padding: 2px 8px;
        font-size: 0.75rem;
        margin-left: auto;
    }
</style>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
