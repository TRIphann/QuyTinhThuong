@model List<QLDuLichRBAC_Upgrade.Models.Entities.SupportTask>
@{
    ViewData["Title"] = "Chi Tiêu Của Tôi";
    var fullName = ViewData["FullName"]?.ToString() ?? "Khách hàng";
}

@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo">K</div>
            <div class="brand-text">
                <div class="brand-name">Khách Hàng</div>
                <div class="brand-sub">QL Quỹ Tình Thương</div>
            </div>
        </div>

        <nav class="menu">
            <a class="menu-item" asp-controller="Accountant" asp-action="Index">
                <span class="mi-ico">🏠</span>
                <span class="mi-text">Tổng quan</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Donations">
                <span class="mi-ico">💳</span>
                <span class="mi-text">Ủng hộ / Thanh toán</span>
            </a>
            <a class="menu-item active" asp-controller="Accountant" asp-action="MyExpenses">
                <span class="mi-ico">📊</span>
                <span class="mi-text">Chi tiêu của tôi</span>
            </a>
            <a class="menu-item" asp-controller="Accountant" asp-action="Reports">
                <span class="mi-ico">📈</span>
                <span class="mi-text">Báo cáo</span>
            </a>
            <div class="menu-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item danger" style="width:100%; text-align:left;">
                    <span class="mi-ico">⎋</span>
                    <span class="mi-text">Đăng xuất</span>
                </button>
            </form>
        </nav>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Chi Tiêu Của Tôi</div>
                    <div class="subtitle">Theo dõi trạng thái các khoản hỗ trợ đã đóng góp</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="user-chip">
                    <div class="avatar">@fullName.Substring(0, 1).ToUpper()</div>
                    <div class="user-meta">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Khách Hàng</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            <!-- Stats Summary -->
            <div class="stats-grid">
                <div class="stat-card yellow">
                    <div class="stat-icon">⏳</div>
                    <div class="stat-info">
                        <div class="stat-value">@Model.Count(t => t.Status != "Hoàn thành")</div>
                        <div class="stat-label">Đang xử lý</div>
                    </div>
                </div>
                <div class="stat-card green">
                    <div class="stat-icon">✅</div>
                    <div class="stat-info">
                        <div class="stat-value">@Model.Count(t => t.Status == "Hoàn thành")</div>
                        <div class="stat-label">Hoàn thành</div>
                    </div>
                </div>
                <div class="stat-card blue">
                    <div class="stat-icon">💰</div>
                    <div class="stat-info">
                        <div class="stat-value">@Model.Sum(t => t.SupportRequest?.RequestedAmount ?? 0).ToString("N0")</div>
                        <div class="stat-label">Tổng đóng góp (VND)</div>
                    </div>
                </div>
            </div>

            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">📋</div>
                    <div class="empty-text">Chưa có khoản hỗ trợ nào</div>
                    <a href="@Url.Action("Donations", "Accountant")" class="btn-primary">Đóng góp ngay</a>
                </div>
            }
            else
            {
                <div class="expense-list">
                    @foreach (var t in Model.OrderByDescending(x => x.CreatedAt))
                    {
                        var canComplain = t.Status == "Hoàn thành" && (DateTime.Now - (t.ManagerVerifiedAt ?? DateTime.Now)).TotalDays >= 3;
                        var alreadyComplained = t.Complaints?.Any() ?? false;
                        var daysRemaining = 3 - (int)(DateTime.Now - (t.ManagerVerifiedAt ?? DateTime.Now)).TotalDays;
                        
                        <div class="expense-card">
                            <div class="expense-header">
                                <div class="expense-id">#@t.TaskId</div>
                                <div class="status-track">
                                    <div class="track-step @(t.Status != "Chờ phân công" ? "completed" : "active")">
                                        <div class="step-dot">1</div>
                                        <div class="step-label">Đã thanh toán</div>
                                    </div>
                                    <div class="track-line @(t.Status != "Chờ phân công" ? "completed" : "")"></div>
                                    <div class="track-step @(new[]{"Đang thực hiện", "Chờ xác minh", "Hoàn thành"}.Contains(t.Status) ? "completed" : (t.Status == "Chờ phân công" ? "" : "active"))">
                                        <div class="step-dot">2</div>
                                        <div class="step-label">Đang hỗ trợ</div>
                                    </div>
                                    <div class="track-line @(new[]{"Chờ xác minh", "Hoàn thành"}.Contains(t.Status) ? "completed" : "")"></div>
                                    <div class="track-step @(t.Status == "Hoàn thành" ? "completed" : (t.Status == "Chờ xác minh" ? "active" : ""))">
                                        <div class="step-dot">3</div>
                                        <div class="step-label">Hoàn thành</div>
                                    </div>
                                </div>
                            </div>

                            <div class="expense-body">
                                <div class="beneficiary-info">
                                    <div class="beneficiary-name">@t.SupportRequest?.Beneficiary?.FullName</div>
                                    <div class="beneficiary-type">@t.SupportRequest?.Beneficiary?.BeneficiaryType</div>
                                </div>
                                <div class="expense-amount">@t.SupportRequest?.RequestedAmount.ToString("N0") VND</div>
                            </div>

                            <div class="expense-details">
                                <div class="detail-row">
                                    <span class="detail-label">Lý do:</span>
                                    <span class="detail-value">@t.SupportRequest?.Reason</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Ngày thanh toán:</span>
                                    <span class="detail-value">@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                @if (t.AssignedStaff != null)
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">Nhân viên phụ trách:</span>
                                        <span class="detail-value highlight">@t.AssignedStaff.FullName</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(t.StaffNote))
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">Ghi chú thực hiện:</span>
                                        <span class="detail-value">@t.StaffNote</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(t.ManagerNote))
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">Ghi chú xác minh:</span>
                                        <span class="detail-value">@t.ManagerNote</span>
                                    </div>
                                }
                                @if (t.Status == "Hoàn thành" && t.ManagerVerifiedAt.HasValue)
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">Hoàn thành lúc:</span>
                                        <span class="detail-value success">@t.ManagerVerifiedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                }
                            </div>

                            <div class="expense-actions">
                                @if (t.Status == "Hoàn thành")
                                {
                                    @if (alreadyComplained)
                                    {
                                        <div class="complaint-status">
                                            <span class="complaint-icon">📩</span>
                                            <span>Đã gửi khiếu nại</span>
                                        </div>
                                    }
                                    else if (canComplain)
                                    {
                                        <button type="button" class="btn-complaint" onclick="showComplaintModal(@t.TaskId, '@t.SupportRequest?.Beneficiary?.FullName?.Replace("'", "\\'")' )">
                                            ⚠️ Gửi khiếu nại
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="complaint-countdown">
                                            <span>⏱️ Có thể khiếu nại sau @daysRemaining ngày</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="processing-status">
                                        <span class="processing-icon">⏳</span>
                                        <span>@t.Status</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </main>
</div>

<!-- Modal khiếu nại -->
<div id="complaintModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <button type="button" class="modal-close" onclick="closeComplaintModal()">&times;</button>
        <div class="modal-header">
            <h2>⚠️ Gửi khiếu nại</h2>
            <p id="complaintBeneficiary" class="modal-subtitle"></p>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Nội dung khiếu nại <span class="required">*</span></label>
                <textarea id="complaintContent" rows="5" placeholder="Mô tả chi tiết vấn đề bạn gặp phải..."></textarea>
            </div>
            <p class="note">Khiếu nại sẽ được gửi đến quản lý để xem xét và phản hồi.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-submit-complaint" onclick="submitComplaint()">Gửi khiếu nại</button>
            <button type="button" class="btn-secondary" onclick="closeComplaintModal()">Hủy</button>
        </div>
    </div>
</div>

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px;
        background: linear-gradient(145deg, #1e1e2e, #252538);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .stat-card.yellow { border-left: 4px solid #fbbf24; }
    .stat-card.green { border-left: 4px solid #22c55e; }
    .stat-card.blue { border-left: 4px solid #3b82f6; }

    .stat-icon {
        font-size: 32px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #ffffff;
    }

    .stat-label {
        font-size: 13px;
        color: #808090;
    }

    .expense-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .expense-card {
        background: linear-gradient(145deg, #1e1e2e, #252538);
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .expense-header {
        padding: 20px 24px;
        background: rgba(0, 0, 0, 0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .expense-id {
        font-size: 13px;
        font-weight: 600;
        color: #6366f1;
        margin-bottom: 16px;
    }

    /* Status Track */
    .status-track {
        display: flex;
        align-items: center;
        gap: 0;
    }

    .track-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .step-dot {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.1);
        color: #808090;
        border-radius: 50%;
        font-size: 12px;
        font-weight: 600;
        border: 2px solid rgba(255, 255, 255, 0.1);
    }

    .track-step.active .step-dot {
        background: rgba(99, 102, 241, 0.2);
        color: #6366f1;
        border-color: #6366f1;
    }

    .track-step.completed .step-dot {
        background: #22c55e;
        color: white;
        border-color: #22c55e;
    }

    .step-label {
        font-size: 11px;
        color: #808090;
        text-align: center;
        max-width: 80px;
    }

    .track-step.active .step-label,
    .track-step.completed .step-label {
        color: #c0c0d0;
    }

    .track-line {
        flex: 1;
        height: 2px;
        background: rgba(255, 255, 255, 0.1);
        margin: 0 8px 24px;
    }

    .track-line.completed {
        background: #22c55e;
    }

    .expense-body {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px;
    }

    .beneficiary-name {
        font-size: 20px;
        font-weight: 600;
        color: #ffffff;
    }

    .beneficiary-type {
        font-size: 13px;
        color: #808090;
        margin-top: 4px;
    }

    .expense-amount {
        font-size: 28px;
        font-weight: 700;
        color: #22c55e;
    }

    .expense-details {
        padding: 0 24px 24px;
    }

    .detail-row {
        display: flex;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        min-width: 140px;
        font-size: 14px;
        color: #808090;
    }

    .detail-value {
        font-size: 14px;
        color: #c0c0d0;
    }

    .detail-value.highlight {
        color: #6366f1;
    }

    .detail-value.success {
        color: #22c55e;
        font-weight: 500;
    }

    .expense-actions {
        padding: 16px 24px;
        background: rgba(0, 0, 0, 0.25);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: flex-end;
    }

    .btn-complaint {
        padding: 12px 24px;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        border: none;
        border-radius: 10px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-complaint:hover {
        transform: scale(1.02);
    }

    .complaint-countdown {
        font-size: 13px;
        color: #808090;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .complaint-status {
        font-size: 13px;
        color: #fbbf24;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .processing-status {
        font-size: 13px;
        color: #6366f1;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .processing-icon {
        font-size: 16px;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 20px;
    }

    .empty-text {
        font-size: 18px;
        color: #808090;
        margin-bottom: 20px;
    }

    .btn-primary {
        display: inline-block;
        padding: 14px 28px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .modal-content {
        background: linear-gradient(145deg, #1e1e2e, #252538);
        border-radius: 16px;
        max-width: 500px;
        width: 90%;
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .modal-close {
        position: absolute;
        top: 16px; right: 16px;
        width: 32px; height: 32px;
        border: none;
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        font-size: 20px;
        border-radius: 50%;
        cursor: pointer;
    }

    .modal-header {
        padding: 24px 24px 16px;
        text-align: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .modal-header h2 {
        margin: 0;
        font-size: 20px;
        color: #ffffff;
    }

    .modal-subtitle {
        margin: 8px 0 0;
        color: #a0a0b0;
    }

    .modal-body {
        padding: 24px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #c0c0d0;
        font-weight: 500;
    }

    .form-group .required {
        color: #ef4444;
    }

    .form-group textarea {
        width: 100%;
        padding: 12px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        color: #ffffff;
        font-size: 14px;
        resize: vertical;
    }

    .modal-body .note {
        margin-top: 12px;
        font-size: 12px;
        color: #808090;
    }

    .modal-footer {
        padding: 16px 24px 24px;
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .btn-submit-complaint {
        padding: 12px 24px;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-secondary {
        padding: 12px 24px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        border-radius: 8px;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .stats-grid { grid-template-columns: 1fr; }
        .expense-body { flex-direction: column; gap: 12px; text-align: center; }
        .status-track { flex-wrap: wrap; justify-content: center; }
    }
</style>

<script>
    let currentTaskId = 0;

    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });

    function showComplaintModal(taskId, beneficiary) {
        currentTaskId = taskId;
        document.getElementById('complaintBeneficiary').textContent = 'Về hỗ trợ: ' + beneficiary;
        document.getElementById('complaintContent').value = '';
        document.getElementById('complaintModal').style.display = 'flex';
    }

    function closeComplaintModal() {
        document.getElementById('complaintModal').style.display = 'none';
        currentTaskId = 0;
    }

    function submitComplaint() {
        const content = document.getElementById('complaintContent').value;
        if (!content.trim()) {
            alert('Vui lòng nhập nội dung khiếu nại');
            return;
        }

        fetch('/Accountant/SubmitComplaint', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: `taskId=${currentTaskId}&content=${encodeURIComponent(content)}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                closeComplaintModal();
                location.reload();
            } else {
                alert('Lỗi: ' + data.message);
            }
        })
        .catch(err => alert('Lỗi kết nối: ' + err.message));
    }
</script>
