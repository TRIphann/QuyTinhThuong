@model List<QLDuLichRBAC_Upgrade.Models.Entities.Beneficiary>
@{
    ViewData["Title"] = "Đối Tượng Hỗ Trợ";
    var currentStatus = ViewData["CurrentStatus"]?.ToString() ?? "all";
    var pendingCount = ViewData["PendingCount"] as int? ?? 0;
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <partial name="_AdminSidebar" />

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Quản Lý Đối Tượng Hỗ Trợ</div>
                    <div class="subtitle">Tổng: @Model.Count đối tượng @(pendingCount > 0 ? $"({pendingCount} chờ duyệt)" : "")</div>
                </div>
            </div>
            <div class="topbar-right">
                <a asp-action="CreateBeneficiary" class="btn btn-primary">+ Thêm mới</a>
            </div>
        </header>

        <section class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" style="background: #22c55e20; color: #22c55e; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
                    @TempData["Success"]
                </div>
            }

            <!-- Status Tabs -->
            <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
                <a href="@Url.Action("Beneficiaries")" class="btn @(currentStatus == "all" ? "btn-primary" : "btn-secondary")">
                    Tất cả (@Model.Count)
                </a>
                <a href="@Url.Action("Beneficiaries", new { status = "Chờ duyệt" })" class="btn @(currentStatus == "Chờ duyệt" ? "btn-primary" : "btn-secondary")" style="@(pendingCount > 0 ? "background: #f59e0b; color: white;" : "")">
                    ⏳ Chờ duyệt (@Model.Count(b => b.Status == "Chờ duyệt"))
                </a>
                <a href="@Url.Action("Beneficiaries", new { status = "Đã duyệt" })" class="btn @(currentStatus == "Đã duyệt" ? "btn-primary" : "btn-secondary")">
                    ✅ Đã duyệt (@Model.Count(b => b.Status == "Đã duyệt"))
                </a>
                <a href="@Url.Action("Beneficiaries", new { status = "Từ chối" })" class="btn @(currentStatus == "Từ chối" ? "btn-primary" : "btn-secondary")">
                    ❌ Từ chối (@Model.Count(b => b.Status == "Từ chối"))
                </a>
            </div>

            <div class="card panel">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Họ tên</th>
                            <th>Loại</th>
                            <th>Địa chỉ</th>
                            <th>Người tạo</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td>@b.BeneficiaryId</td>
                                <td><strong>@b.FullName</strong></td>
                                <td>
                                    <span class="badge" style="background: #6366f120; color: #818cf8; padding: 4px 8px; border-radius: 4px;">
                                        @b.BeneficiaryType
                                    </span>
                                </td>
                                <td>@b.Address</td>
                                <td>@(b.Creator?.FullName ?? "Hệ thống")</td>
                                <td>
                                    @if (b.Status == "Chờ duyệt")
                                    {
                                        <span class="badge" style="background: #f59e0b20; color: #f59e0b; padding: 4px 8px; border-radius: 4px;">⏳ Chờ duyệt</span>
                                    }
                                    else if (b.Status == "Đã duyệt")
                                    {
                                        <span class="badge" style="background: #22c55e20; color: #22c55e; padding: 4px 8px; border-radius: 4px;">✅ Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: #ef444420; color: #ef4444; padding: 4px 8px; border-radius: 4px;">❌ Từ chối</span>
                                    }
                                </td>
                                <td>
                                    @if (b.Status == "Chờ duyệt")
                                    {
                                        <button class="btn btn-sm" style="background: #22c55e; color: white; padding: 4px 12px; border: none; border-radius: 4px; cursor: pointer; margin-right: 4px;" 
                                                onclick="approveBeneficiary(@b.BeneficiaryId)">✓ Duyệt</button>
                                        <button class="btn btn-sm" style="background: #ef4444; color: white; padding: 4px 12px; border: none; border-radius: 4px; cursor: pointer;" 
                                                onclick="rejectBeneficiary(@b.BeneficiaryId)">✗ Từ chối</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div style="text-align: center; padding: 2rem; color: #64748b;">
                        Không có đối tượng nào
                    </div>
                }
            </div>
        </section>
    </main>
</div>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });

    function approveBeneficiary(id) {
        if (!confirm('Xác nhận duyệt đối tượng này?')) return;
        
        fetch('/Admin/ApproveBeneficiary', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: `id=${id}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Lỗi');
            }
        });
    }

    function rejectBeneficiary(id) {
        if (!confirm('Xác nhận từ chối đối tượng này?')) return;
        
        fetch('/Admin/RejectBeneficiary', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: `id=${id}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Lỗi');
            }
        });
    }
</script>

@Html.AntiForgeryToken()
