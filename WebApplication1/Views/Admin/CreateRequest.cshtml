@{
    ViewData["Title"] = "Tạo Yêu Cầu Hỗ Trợ";
    var beneficiaries = ViewData["Beneficiaries"] as List<QLDuLichRBAC_Upgrade.Models.Entities.Beneficiary> ?? new List<QLDuLichRBAC_Upgrade.Models.Entities.Beneficiary>();
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="admin-shell">
    <partial name="_AdminSidebar" />

    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn" type="button" id="toggleSidebar">☰</button>
                <div class="page-title">
                    <div class="title">Tạo Yêu Cầu Hỗ Trợ</div>
                    <div class="subtitle">Tạo yêu cầu hỗ trợ cho đối tượng đã được duyệt</div>
                </div>
            </div>
        </header>

        <section class="content">
            <div class="card panel" style="max-width: 600px;">
                <div class="panel-head">
                    <div class="panel-title">Thông tin yêu cầu</div>
                </div>

                <form method="post" asp-action="CreateRequest" style="padding: 1.5rem;">
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label style="display: block; margin-bottom: 0.5rem; color: #f8fafc;">Đối tượng hỗ trợ <span style="color: #ef4444;">*</span></label>
                        <select name="beneficiaryId" required
                                style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #1e293b; color: #f8fafc; border: 1px solid #334155;">
                            <option value="">-- Chọn đối tượng --</option>
                            @foreach (var b in beneficiaries)
                            {
                                <option value="@b.BeneficiaryId">@b.FullName - @b.BeneficiaryType</option>
                            }
                        </select>
                        @if (!beneficiaries.Any())
                        {
                            <small style="color: #f59e0b;">Chưa có đối tượng nào được duyệt. Vui lòng duyệt đối tượng trước.</small>
                        }
                    </div>

                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label style="display: block; margin-bottom: 0.5rem; color: #f8fafc;">Số tiền yêu cầu (VND) <span style="color: #ef4444;">*</span></label>
                        <input type="number" name="requestedAmount" required min="100000" step="100000" placeholder="Nhập số tiền"
                               style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #1e293b; color: #f8fafc; border: 1px solid #334155;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 1.5rem;">
                        <label style="display: block; margin-bottom: 0.5rem; color: #f8fafc;">Lý do hỗ trợ <span style="color: #ef4444;">*</span></label>
                        <textarea name="reason" rows="4" required placeholder="Nhập lý do cần hỗ trợ..."
                                  style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #1e293b; color: #f8fafc; border: 1px solid #334155;"></textarea>
                    </div>

                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" style="flex: 1; padding: 0.75rem; background: #22c55e; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 1rem;" @(beneficiaries.Any() ? "" : "disabled")>
                            ✓ Tạo yêu cầu
                        </button>
                        <a asp-action="Requests" style="flex: 1; padding: 0.75rem; background: #64748b; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 1rem; text-align: center; text-decoration: none;">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </section>
    </main>
</div>

<script>
    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.querySelector('.admin-shell')?.classList.toggle('collapsed');
    });
</script>
